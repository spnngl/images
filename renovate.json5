{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Keeps every pinned version current: base images, the k3s release of kubeenv, application images' upstream releases, build tools, GitHub Actions. Base images are pinned to a major release, not a digest: the weekly rebuild (build-bootc.yml) picks up their updates within it.",
    "extends": ["github>spnngl/.github:renovate.default.json5"],
    // Digests for actions only (the preset's config:best-practices pins
    // images too): a digest on a Containerfile's FROM would freeze the base
    // image between rebuilds, and the dockerfile manager would write it into
    // `ARG BASE_VERSION`, which is also the image's tag.
    "ignorePresets": ["docker:pinDigests"],
    // The day before the weekly rebuild (Sunday 07:00, build-bootc.yml and build-apps.yml), so a
    // merged update ships with it.
    "schedule": ["at any time"],
    "automergeSchedule": ["at any time"],
    // dockerfile: FROM lines, with `ARG BASE_VERSION` resolved, so the
    // Containerfile default of a base image is updated in place.
    "enabledManagers": ["dockerfile", "github-actions", "custom.regex"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "fedora-bootc release in the build-bootc.yml matrix (the Containerfile's ARG BASE_VERSION is the dockerfile manager's: same dependency, same PR).",
            "managerFilePatterns": ["/^\\.github/workflows/build-bootc\\.yml$/"],
            "matchStrings": [
                "- name: fedora\\n\\s+version: \"(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "quay.io/fedora/fedora-bootc",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "almalinux-bootc major releases in the build-bootc.yml matrix (the Containerfile's ARG BASE_VERSION is the dockerfile manager's).",
            "managerFilePatterns": ["/^\\.github/workflows/build-bootc\\.yml$/"],
            "matchStrings": [
                "- name: almalinux\\n\\s+version: \"(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "quay.io/almalinuxorg/almalinux-bootc",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "centos-bootc major releases: the build-bootc.yml matrix and the Containerfile's ARG BASE_VERSION, one dependency. Not the dockerfile manager's (disabled for it in packageRules): the base image tag is stream<BASE_VERSION>, which it can't write back into the ARG. Only the stream<n> tags count, as <n>.",
            "managerFilePatterns": [
                "/^\\.github/workflows/build-bootc\\.yml$/",
                "/^images/centos/Containerfile$/"
            ],
            "matchStrings": [
                "- name: centos\\n\\s+version: \"(?<currentValue>[^\"]+)\"",
                "ARG BASE_VERSION=(?<currentValue>\\S+)"
            ],
            "depNameTemplate": "quay.io/centos-bootc/centos-bootc",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker",
            "extractVersionTemplate": "^stream(?<version>\\d+)$"
        },
        {
            "customType": "regex",
            "description": "k3s release of kubeenv in the build-bootc.yml matrix (its tag, v<x.y.z>+k3s<n>), with the -v<Kubernetes minor release>k3s tag suffix on the line above it: one replacement, so both always change together. Versioning: the k3s tag's (workarounds:k3sKubernetesVersioning, in config:recommended).",
            "managerFilePatterns": ["/^\\.github/workflows/build-bootc\\.yml$/"],
            "matchStrings": [
                "suffix: &kubeenv -v\\d+\\.\\d+k3s\\n(?<indentation>[ ]*)k3s: &k3s (?<currentValue>\\S+)"
            ],
            "autoReplaceStringTemplate": "suffix: &kubeenv -v{{{newMajor}}}.{{{newMinor}}}k3s\n{{{indentation}}}k3s: &k3s {{{newValue}}}",
            "depNameTemplate": "k3s",
            "packageNameTemplate": "k3s-io/k3s",
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "description": "k3s release of kubeenv: the Containerfiles' ARG INSTALL_K3S_VERSION default (same dependency as the build-bootc.yml matrix, same PR).",
            "managerFilePatterns": ["/^images/[^/]+/Containerfile$/"],
            "matchStrings": ["ARG INSTALL_K3S_VERSION=(?<currentValue>\\S+)"],
            "depNameTemplate": "k3s",
            "packageNameTemplate": "k3s-io/k3s",
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "description": "cs-firewall-bouncer release: the Containerfile's ARG BASE_VERSION. build-apps.yml reads the version from the Containerfile.",
            "managerFilePatterns": [
                "/^images/cs-firewall-bouncer/Containerfile$/"
            ],
            "matchStrings": ["ARG BASE_VERSION=(?<currentValue>\\S+)"],
            "depNameTemplate": "crowdsecurity/cs-firewall-bouncer",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
        },
        {
            "customType": "regex",
            "description": "Garage release: the Containerfile's ARG BASE_VERSION with the --checksum of its source (the tag's commit, one match so both change together), from the tags of upstream's Forgejo (no GitHub repository; release candidates left out). build-apps.yml reads the version from the Containerfile.",
            "managerFilePatterns": ["/^images/garage/Containerfile$/"],
            "matchStrings": [
                "ARG BASE_VERSION=(?<currentValue>\\S+)\\n[\\s\\S]*?--checksum=(?<currentDigest>[0-9a-f]{40})"
            ],
            "depNameTemplate": "Deuxfleurs/garage",
            "datasourceTemplate": "forgejo-tags",
            "registryUrlTemplate": "https://git.deuxfleurs.fr",
            "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
        },
        {
            "customType": "regex",
            "description": "MinIO and its forks (minio/minio, pgsty/silo, pgsty/mc): a Containerfile's ARG BASE_VERSION=RELEASE.<date>T<time>Z with the --checksum of its source (the tag's commit, one match so both change together), the repository from the ADD URL that follows. Any image of that form is picked up. Tags: minio/minio publishes no GitHub releases. Versioning: by date then time (the seconds left out: regex versioning has five parts). build-apps.yml reads the version from the Containerfile.",
            "managerFilePatterns": ["/^images/[^/]+/Containerfile$/"],
            "matchStrings": [
                "ARG BASE_VERSION=(?<currentValue>RELEASE\\.\\S+)\\n[\\s\\S]*?--checksum=(?<currentDigest>[0-9a-f]{40})[\\s\\\\]+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)\\.git#"
            ],
            "datasourceTemplate": "github-tags",
            "versioningTemplate": "regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?<build>\\d{2})-(?<revision>\\d{2})-\\d{2}Z$"
        },
        {
            "customType": "regex",
            "description": "SABnzbd release: the spec's args.BASE_VERSION with the checksum of its source (the tag's commit, one match so both change together). build-apps.yml reads the version from the spec.",
            "managerFilePatterns": ["/^images/sabnzbd/spec\\.yml$/"],
            "matchStrings": [
                "BASE_VERSION: (?<currentValue>\\S+)\\n[\\s\\S]*?url: https://github\\.com/sabnzbd/sabnzbd\\.git\\n\\s+commit: \\$\\{BASE_VERSION\\}\\n(?:\\s+#.*\\n)*\\s+checksum: (?<currentDigest>[0-9a-f]{40})"
            ],
            "depNameTemplate": "sabnzbd/sabnzbd",
            "datasourceTemplate": "github-tags",
            "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
        },
        {
            "customType": "regex",
            "description": "par2cmdline-turbo release: the spec's args.PAR2_VERSION with the checksum of its source (the tag's commit).",
            "managerFilePatterns": ["/^images/sabnzbd/spec\\.yml$/"],
            "matchStrings": [
                "PAR2_VERSION: (?<currentValue>\\S+)\\n[\\s\\S]*?url: https://github\\.com/animetosho/par2cmdline-turbo\\.git\\n\\s+commit: v\\$\\{PAR2_VERSION\\}\\n(?:\\s+#.*\\n)*\\s+checksum: (?<currentDigest>[0-9a-f]{40})"
            ],
            "depNameTemplate": "animetosho/par2cmdline-turbo",
            "datasourceTemplate": "github-tags",
            "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
        },
        {
            "customType": "regex",
            "description": "nftables-exporter release: the spec's args.BASE_VERSION with the checksum of its source (the tag's commit). Tags: upstream publishes no GitHub releases.",
            "managerFilePatterns": ["/^images/nftables-exporter/spec\\.yml$/"],
            "matchStrings": [
                "BASE_VERSION: (?<currentValue>\\S+)\\n[\\s\\S]*?url: https://github\\.com/metal-stack/nftables-exporter\\.git\\n\\s+commit: v\\$\\{BASE_VERSION\\}\\n(?:\\s+#.*\\n)*\\s+checksum: (?<currentDigest>[0-9a-f]{40})"
            ],
            "depNameTemplate": "metal-stack/nftables-exporter",
            "datasourceTemplate": "github-tags",
            "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
        },
        {
            "customType": "regex",
            "description": "Go of the nftables-exporter spec: its golang-<major.minor>-go build dependency, from trixie-backports, whose golang-go (version 2:<major.minor>~...) depends on the newest one. Through Repology, by source package (golang-defaults builds golang-go): the deb datasource only reads Packages.gz, and backports only publishes Packages.xz.",
            "managerFilePatterns": ["/^images/nftables-exporter/spec\\.yml$/"],
            "matchStrings": ["\\bgolang-(?<currentValue>\\d+\\.\\d+)-go: "],
            "depNameTemplate": "golang-go",
            "packageNameTemplate": "debian_13_backports/golang-defaults",
            "datasourceTemplate": "repology",
            "extractVersionTemplate": "^\\d+:(?<version>\\d+\\.\\d+)~",
            "versioningTemplate": "loose"
        },
        {
            "customType": "regex",
            "description": "Jellyfin release: the spec's args.BASE_VERSION, from the jellyfin-server package of Jellyfin's trixie repository (<version>+deb13), not GitHub: the spec repackages it, so a PR only comes once it is installable. amd64's index: both architectures are published together. build-apps.yml reads the version from the spec.",
            "managerFilePatterns": ["/^images/jellyfin/spec\\.yml$/"],
            "matchStrings": ["BASE_VERSION: \"(?<currentValue>[^\"]+)\""],
            "depNameTemplate": "jellyfin-server",
            "datasourceTemplate": "deb",
            "registryUrlTemplate": "https://repo.jellyfin.org/debian?suite=trixie&components=main&binaryArch=amd64",
            "extractVersionTemplate": "^(?<version>\\d+\\.\\d+(?:\\.\\d+)?)\\+deb13$",
            "versioningTemplate": "loose"
        },
        {
            "customType": "regex",
            "description": "Dalec frontend of the specs (# syntax= line, which the dockerfile manager only reads in Containerfiles).",
            "managerFilePatterns": ["/^images/[^/]+/spec\\.yml$/"],
            "matchStrings": [
                "# syntax=(?<depName>[^:\\s]+):(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "uv image of the SABnzbd spec (args.UV_VERSION).",
            "managerFilePatterns": ["/^images/sabnzbd/spec\\.yml$/"],
            "matchStrings": ["UV_VERSION: (?<currentValue>\\S+)"],
            "depNameTemplate": "ghcr.io/astral-sh/uv",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Images run by the scripts and the commands in the docs (image-builder-cli, hadolint...).",
            "managerFilePatterns": ["/^scripts/[^/]+\\.sh$/", "/^[^/]+\\.md$/"],
            "matchStrings": [
                "(?<depName>(?:docker|ghcr|quay)\\.io/[a-z0-9._/-]+):(?<currentValue>v?\\d[\\w.-]*)"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": "Wait 3 days before proposing a GitHub or Forgejo release or tag (actions, k3s, upstream sources): time for a broken or malicious release to be pulled, and for CRI-O to publish the repository of a new Kubernetes minor release. Not images: Renovate only gets release dates from Docker Hub, and holds updates without one.",
            "matchDatasources": [
                "github-releases",
                "github-tags",
                "forgejo-tags"
            ],
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "GitHub Actions and runners: one PR for all, like Dependabot did, automerged once CI is green.",
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
            "groupName": "GitHub Actions",
            "semanticCommitType": "ci",
            "automerge": true
        },
        {
            "description": "Build tools and application releases that CI exercises (the Containerfiles' smoke tests, the spec's tests, test_geoblock.nu), or doc-only: automerge minor/patch once CI is green. Not digest updates: for par2cmdline-turbo, a moved tag. Garage: its build stage runs a single-node server through the S3 API; a major release needs a migration (upstream's working-documents/migration-<major>.md), by hand.",
            "matchDepNames": [
                "docker.io/library/golang",
                "docker.io/library/rust",
                "Deuxfleurs/garage",
                "golang-go",
                "ghcr.io/nushell/nushell",
                "ghcr.io/project-dalec/dalec/frontend",
                "animetosho/par2cmdline-turbo",
                "docker.io/hadolint/hadolint",
                "ghcr.io/renovatebot/renovate"
            ],
            "matchUpdateTypes": ["minor", "patch"],
            "automerge": true
        },
        {
            "description": "Silo and pgsty/mc: every release automerged once CI is green (the build stage tests it: Silo's runs a server through the S3 API). Major too: the versioning is by date, so a new year is a major update, not a breaking change. Not digest updates: a moved tag. The note keeps what changed in the merged PR.",
            "matchDepNames": ["pgsty/silo", "pgsty/mc"],
            "matchUpdateTypes": ["major", "minor", "patch"],
            "automerge": true,
            "prBodyNotes": [
                "What changed: https://github.com/{{{depName}}}/compare/{{{currentValue}}}...{{{newValue}}}"
            ]
        },
        {
            "description": "k3s: automerge (k3s builds, Kubernetes patch and minor releases: there is no 2.x). A minor release fails CI until CRI-O publishes its repository (images/k3s/install.sh); re-run the PR's checks then. Patch releases get their own PR meanwhile.",
            "matchDepNames": ["k3s"],
            "automerge": true,
            "separateMinorPatch": true
        },
        {
            "description": "A Kubernetes minor release changes the kubeenv tags: hosts must move.",
            "matchDepNames": ["k3s"],
            "matchUpdateTypes": ["minor", "major"],
            "prBodyNotes": [
                "Merging changes the `kubeenv` tags (`-v{{{newMajor}}}.{{{newMinor}}}k3s`): `bootc upgrade` stays on the old tag, which is no longer rebuilt. Move hosts with `bootc switch`."
            ]
        },
        {
            "description": "Base images: never automerged, a new major release changes the image tag. CI fails until its sysroot/<BASE_VERSION>/ (policy.json) is added: images/fedora/policy.jq.",
            "matchDepNames": [
                "quay.io/fedora/fedora-bootc",
                "quay.io/almalinuxorg/almalinux-bootc"
            ],
            "prBodyNotes": [
                "Before merging, add `images/<name>/sysroot/{{{newValue}}}/` (from `{{{currentValue}}}/`, removed if no build uses it any more) with the new base's `/etc/containers/policy.json` plus our changes (ARCHITECTURE.md, \"Signing\"). CI fails until then. What changed in the base's file:\n\n```sh\ndiff <(podman run --rm {{{depName}}}:{{{currentValue}}} cat /etc/containers/policy.json) <(podman run --rm {{{depName}}}:{{{newValue}}} cat /etc/containers/policy.json)\n```\n\nMerging changes the image tag: move hosts with `bootc switch`."
            ]
        },
        {
            "description": "CentOS Stream: the same as the base images above, but the base image tag is stream<BASE_VERSION>, and its policy.json is in /usr/share/containers (images/centos/Containerfile).",
            "matchDepNames": ["quay.io/centos-bootc/centos-bootc"],
            "prBodyNotes": [
                "Before merging, add `images/centos/sysroot/{{{newValue}}}/` (from `{{{currentValue}}}/`, removed if no build uses it any more) with the new base's policy.json plus our changes (ARCHITECTURE.md, \"Signing\"). CI fails until then. What changed in the base's file:\n\n```sh\ndiff <(podman run --rm {{{depName}}}:stream{{{currentValue}}} cat /usr/share/containers/policy.json) <(podman run --rm {{{depName}}}:stream{{{newValue}}} cat /usr/share/containers/policy.json)\n```\n\nMerging changes the image tag: move hosts with `bootc switch`."
            ]
        },
        {
            "description": "centos-bootc: the custom regex manager's (customManagers), not the dockerfile manager's: it would read stream<BASE_VERSION> and fail to write it back.",
            "matchManagers": ["dockerfile"],
            "matchDepNames": ["quay.io/centos-bootc/centos-bootc"],
            "enabled": false
        },
        {
            "description": "Fedora releases from endoflife.date, not from the image's tags: quay.io/fedora/fedora-bootc tags the branched release and rawhide with their number months before release.",
            "matchDepNames": ["quay.io/fedora/fedora-bootc"],
            "overrideDatasource": "endoflife-date",
            "overridePackageName": "fedora"
        },
        {
            "description": "AlmaLinux 9 is kept for x86-64-v2 hosts until its end of life (build-bootc.yml): never moved to 10.",
            "matchDepNames": ["quay.io/almalinuxorg/almalinux-bootc"],
            "matchCurrentValue": "9",
            "enabled": false
        },
        {
            "description": "cs-firewall-bouncer: never automerged, its config in the image follows upstream's (ARCHITECTURE.md). Explicit, whatever the shared preset automerges.",
            "matchDepNames": ["crowdsecurity/cs-firewall-bouncer"],
            "automerge": false,
            "prBodyNotes": [
                "Before merging, port upstream's config changes to `images/cs-firewall-bouncer/sysroot/etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml`: https://github.com/crowdsecurity/cs-firewall-bouncer/compare/v{{{currentValue}}}...v{{{newValue}}} (`config/crowdsec-firewall-bouncer.yaml`)."
            ]
        },
        {
            "description": "Garage major releases: never automerged (minor and patch ones are, above), they migrate the metadata for good.",
            "matchDepNames": ["Deuxfleurs/garage"],
            "matchUpdateTypes": ["major"],
            "automerge": false,
            "prBodyNotes": [
                "Before merging, read upstream's migration guide (https://garagehq.deuxfleurs.fr/documentation/working-documents/migration-{{{newMajor}}}/) and the release notes (https://git.deuxfleurs.fr/Deuxfleurs/garage/releases/tag/v{{{newValue}}}). Merging changes the image tag: nodes stay on the old one until moved, following that guide."
            ]
        },
        {
            "description": "uv: never automerged, scripts/sabnzbd-lock.sh compiles the lock with the spec's uv.",
            "matchDepNames": ["ghcr.io/astral-sh/uv"],
            "prBodyNotes": [
                "Before merging: run `scripts/sabnzbd-lock.sh` and commit `images/sabnzbd/requirements.lock` if it changed."
            ]
        },
        {
            "description": "nftables-exporter: never automerged, its config in the image follows upstream's options (ARCHITECTURE.md).",
            "matchDepNames": ["metal-stack/nftables-exporter"],
            "prBodyNotes": [
                "Before merging, port upstream's option changes to `images/nftables-exporter/nftables_exporter.yaml`: https://github.com/metal-stack/nftables-exporter/compare/v{{{currentValue}}}...v{{{newValue}}} (`options.go`). If CI fails with `go.mod requires go >= ...`, bump `golang-<version>-go` in the spec. A checksum-only update means the tag was moved upstream."
            ]
        },
        {
            "description": "Jellyfin: never automerged, a release migrates the database and settings for good.",
            "matchDepNames": ["jellyfin-server"],
            "prBodyNotes": [
                "Before merging, read the release notes (https://github.com/jellyfin/jellyfin/releases/tag/v{{{newValue}}}) and back up `/config`: the new version migrates the database and settings, the old one can't read them any more. Check the spec's command-line options against upstream's `Jellyfin.Server/StartupOptions.cs`."
            ]
        },
        {
            "description": "SABnzbd: never automerged, the lock and the patch need a hand.",
            "matchDepNames": ["sabnzbd/sabnzbd"],
            "prBodyNotes": [
                "Before merging: run `scripts/sabnzbd-lock.sh` and commit `images/sabnzbd/requirements.lock`, and compare `images/sabnzbd/downloads-dir.patch` with upstream's `sabnzbd/constants.py`. A checksum-only update means the tag was moved upstream."
            ]
        },
        {
            "description": "MinIO: never automerged, a release can migrate the data for good, and the repository was archived after the last one.",
            "matchDepNames": ["minio/minio"],
            "prBodyNotes": [
                "Before merging, read what changed (https://github.com/minio/minio/compare/{{{currentValue}}}...{{{newValue}}}) and back up `/data`: the old version may not read what the new one writes. Check the image's flags and variables (`--certs-dir`, `MINIO_CONSOLE_ADDRESS`, `MINIO_UPDATE`) against `cmd/main.go` and `cmd/server-main.go`, and the build against the `build` target of the `Makefile`. A checksum-only update means the tag was moved upstream."
            ]
        }
    ]
}
