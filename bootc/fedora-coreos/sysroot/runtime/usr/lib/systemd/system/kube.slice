# The Kubernetes daemons (containerd, kubelet), out of system.slice:
# Slice=kube.slice in their units' drop-ins. Pods aren't here: the kubelet
# puts them in kubepods.slice, next to this one.
# No memory limit: the kubelet's kubeReserved/systemReserved caps
# kubepods.slice instead. No swap: containerd, its shims and the kubelet
# stay in RAM, as Kubernetes advises for the node's critical daemons. See
# systemd.slice(5), systemd.resource-control(5),
# https://kubernetes.io/docs/tasks/administer-cluster/reserve-compute-resources/
# and https://kubernetes.io/docs/concepts/cluster-administration/swap-memory-management/
[Unit]
Description=Kubernetes daemons (containerd, kubelet)
Documentation=man:systemd.slice(5)

[Slice]
MemorySwapMax=0
