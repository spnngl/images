# The sysctls of usr/lib/sysctl.profiles.d/metal.conf, on dedicated servers.
# After systemd-sysctl, so that these values win; before the network, so that
# the sockets opened from then on get them. Enabled by the Containerfile
# (`wants`).
[Unit]
Description=Apply sysctl tuning on dedicated servers
DefaultDependencies=no
After=systemd-sysctl.service
Before=network-pre.target
ConditionVirtualization=false

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/systemd/systemd-sysctl /usr/lib/sysctl.profiles.d/metal.conf

[Install]
WantedBy=multi-user.target
