<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenSCAP tailoring of scap-security-guide's Fedora `cis` profile (CIS Fedora
  Server, level 2). Each change carries its reason: a rule turned off states
  why this image doesn't follow it, a value states the image's own.

  - `node`: what a running node is checked against.
  - `build`: `node`, less what a container build can't check (the Containerfile's
    `scan` stage).
-->
<Tailoring xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_local_tailoring_fedora-coreos">
  <benchmark href="/usr/share/xml/scap/ssg/content/ssg-fedora-ds.xml"/>
  <version time="2026-11-09T00:00:00">5</version>

  <Profile id="xccdf_local_profile_node" extends="xccdf_org.ssgproject.content_profile_cis">
    <title>Fedora CoreOS node</title>
    <description>CIS Fedora Server level 2, tailored to Fedora CoreOS Kubernetes nodes.</description>

    <!-- The rules of Fedora's `standard` profile that CIS lacks, which the image
         follows: they stay checked. -->
    <select idref="xccdf_org.ssgproject.content_rule_configure_crypto_policy" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_configure_kerberos_crypto_policy" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_configure_openssl_crypto_policy" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_configure_ssh_crypto_policy" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_ensure_gpgcheck_never_disabled" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_no_direct_root_logins" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_restrict_serial_port_logins" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_securetty_root_login_console_only" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_file_ownership_binary_dirs" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_file_ownership_library_dirs" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_file_permissions_binary_dirs" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_file_permissions_library_dirs" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_chronyd_or_ntpd_specify_remote_server" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_service_chronyd_or_ntpd_enabled" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_service_auditd_enabled" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_file_ownership_var_log_audit" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_auditd_audispd_syslog_plugin_activated" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_auditd_data_retention_action_mail_acct" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_auditd_data_retention_admin_space_left_action" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_auditd_data_retention_max_log_file" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_auditd_data_retention_max_log_file_action" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_auditd_data_retention_num_logs" selected="true"/>
    <select idref="xccdf_org.ssgproject.content_rule_auditd_data_retention_space_left_action" selected="true"/>

    <!-- FCOS' values. No mail server: low disk space goes to syslog. Almost full,
         full, or failing, auditd stops writing rather than halt the node or drop
         it to single-user mode: a full /var would take the node down. Logs
         rotate rather than fill /var (CIS level 2 keeps them all); the audit
         syslog plugin sends the events to the journal too. -->
    <set-value idref="xccdf_org.ssgproject.content_value_var_auditd_space_left_action">syslog</set-value>
    <set-value idref="xccdf_org.ssgproject.content_value_var_auditd_admin_space_left_action">suspend</set-value>
    <set-value idref="xccdf_org.ssgproject.content_value_var_auditd_disk_full_action">suspend</set-value>
    <set-value idref="xccdf_org.ssgproject.content_value_var_auditd_disk_error_action">suspend</set-value>
    <set-value idref="xccdf_org.ssgproject.content_value_var_auditd_max_log_file_action">rotate</set-value>

    <!-- /usr is the image's, mounted read-only: an update replaces it whole.
         What drifts, /etc, usr/libexec/etc-diff lists. -->
    <select idref="xccdf_org.ssgproject.content_rule_package_aide_installed" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_aide_build_database" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_aide_check_audit_tools" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_aide_periodic_cron_checking" selected="false"/>

    <!-- No account has a password: logins are SSH keys only, root logs in nowhere.
         Password quality, history and lockout have nothing to act on. Password
         aging would expire the accounts that Ignition creates, and an expired
         account can't log in even with a key. su asks for the target account's
         password: wheel needs no restriction. sudo asks none (99-rootless),
         its timeout has nothing to time. -->
    <select idref="xccdf_org.ssgproject.content_rule_ensure_root_password_configured" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_maximum_age_login_defs" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_minimum_age_login_defs" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_account_disable_post_pw_expiration" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_modules_in_authselect_profile" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_dictcheck" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_difok" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_enforce_root" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_maxrepeat" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_maxsequence" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_minclass" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_minlen" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_pwhistory_remember_password_auth" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_pwhistory_remember_system_auth" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_pwhistory_use_authtok" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_password_pam_unix_authtok" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_account_password_pam_faillock_password_auth" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_account_password_pam_faillock_system_auth" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_passwords_pam_faillock_deny" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_passwords_pam_faillock_unlock_time" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_accounts_passwords_pam_faillock_even_deny_root_or_root_unlock_time" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_ensure_pam_wheel_group_empty" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_use_pam_wheel_group_for_su" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sudo_require_reauthentication" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sudo_remove_nopasswd" selected="false"/>

    <!-- A GRUB password would be a credential in the image. The console is the
         IPMI/KVM of OVH or OpenStack's, both behind the provider's login. -->
    <select idref="xccdf_org.ssgproject.content_rule_grub2_password" selected="false"/>

    <!-- The disk build writes /boot/grub2/console.cfg (osbuild's coreos.platform)
         and bootuuid.cfg (bootupd) 0644. They hold the console arguments and
         /boot's UUID, nothing secret, and /boot is mounted read-only. grub.cfg
         and grubenv are 0600. -->
    <select idref="xccdf_org.ssgproject.content_rule_file_permissions_boot_grub2" selected="false"/>

    <!-- The journal records each sudo command; a log file of sudo's own would
         need its own rotation, and audit would watch a file nothing writes.
         etc/audit/rules.d/50-cis.rules records what sudo runs (user_emulation). -->
    <select idref="xccdf_org.ssgproject.content_rule_sudo_custom_logfile" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_audit_sudo_log_events" selected="false"/>

    <!-- SELinux is permissive (Containerfile, REFERENCES.md): containerd runs
         with enable_selinux = false. -->
    <select idref="xccdf_org.ssgproject.content_rule_selinux_state" selected="false"/>

    <!-- containerd's snapshotter mounts the containers' layers with overlayfs. -->
    <select idref="xccdf_org.ssgproject.content_rule_kernel_module_overlayfs_disabled" selected="false"/>

    <!-- Forwarding is off (etc/ssh/sshd_config.d/00-hardening.conf) but for
         rootless, the only user sshd lets in: `ssh -J` needs local forwarding,
         and the check fails on any `DisableForwarding no`, Match blocks included
         (90-allow-proxyjump.conf). -->
    <select idref="xccdf_org.ssgproject.content_rule_sshd_disable_forwarding" selected="false"/>

    <!-- Fedora's sshd-keygen writes the host keys root:root 0600, and this rule
         wants group ssh_keys. A root:ssh_keys key fails
         file_permissions_sshd_private_key, which reads the group's GID from
         /etc/group only; FCOS keeps it in /usr/lib/group
         (https://github.com/ComplianceAsCode/content/issues/15320). Back on
         with https://github.com/ComplianceAsCode/content/pull/15310 -->
    <select idref="xccdf_org.ssgproject.content_rule_file_groupownership_sshd_private_key" selected="false"/>

    <!-- Cilium filters the host (host policies); FCOS has no firewalld. -->
    <select idref="xccdf_org.ssgproject.content_rule_package_firewalld_installed" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_firewalld_loopback_traffic_restricted" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_firewalld_loopback_traffic_trusted" selected="false"/>

    <!-- FCOS has no cron nor at: systemd timers schedule. -->
    <select idref="xccdf_org.ssgproject.content_rule_package_cron_installed" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_service_crond_enabled" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_file_cron_allow_exists" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_file_at_allow_exists" selected="false"/>

    <!-- Core dumps are kept, compressed, to debug crashes
         (usr/lib/systemd/coredump.conf.d/10-default.conf). -->
    <select idref="xccdf_org.ssgproject.content_rule_coredump_disable_backtraces" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_coredump_disable_storage" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_disable_users_coredumps" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_fs_suid_dumpable" selected="false"/>

    <!-- rpm 6 names a key by its full fingerprint (gpg-pubkey-36f612dc...), and
         the check looks for rpm 4's short ids, and for Fedora 37 to 40's keys.
         Fedora's keys are installed. Fixed upstream by
         https://github.com/ComplianceAsCode/content/pull/15304 -->
    <select idref="xccdf_org.ssgproject.content_rule_ensure_fedora_gpgkey_installed" selected="false"/>

    <!-- The node routes its pods' traffic. rp_filter: the kernel applies the higher
         of `all` and the interface's, and Cilium sets 0 on its own. -->
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_ip_forward" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_all_forwarding" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_default_forwarding" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_all_rp_filter" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_default_rp_filter" selected="false"/>

    <!-- IPv6 is off (usr/lib/sysctl.d/995-ipv6.conf). -->
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_all_accept_ra" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_default_accept_ra" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_all_accept_redirects" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_default_accept_redirects" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_all_accept_source_route" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_default_accept_source_route" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_all_forwarding" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_default_forwarding" selected="false"/>

    <!-- Not decided yet: idle shell timeout, CIS's crypto policy, shipping the
         journal off the node. -->
    <select idref="xccdf_org.ssgproject.content_rule_accounts_tmout" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_configure_custom_crypto_policy_cis" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_package_systemd-journal-remote_installed" selected="false"/>
  </Profile>

  <Profile id="xccdf_local_profile_build" extends="xccdf_local_profile_node">
    <title>Fedora CoreOS image build</title>
    <description>The node profile, less what only a booted node shows.</description>
    <!-- They ask systemd, which a container build doesn't run. -->
    <select idref="xccdf_org.ssgproject.content_rule_service_auditd_enabled" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_service_chronyd_or_ntpd_enabled" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_service_systemd-journald_enabled" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_socket_systemd-journal-remote_disabled" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_ensure_journald_and_rsyslog_not_active_together" selected="false"/>
    <!-- Mounted at boot: /tmp by tmp.mount, /dev/shm's options by wx-remount. -->
    <select idref="xccdf_org.ssgproject.content_rule_partition_for_tmp" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_mount_option_dev_shm_nodev" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_mount_option_dev_shm_noexec" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_mount_option_dev_shm_nosuid" selected="false"/>
    <!-- The image's /var is empty: audit's tmpfiles.d makes /var/log/audit at
         boot. -->
    <select idref="xccdf_org.ssgproject.content_rule_directory_permissions_var_log_audit" selected="false"/>
    <!-- They read the boot entries, which a disk has and an image doesn't. bootc
         puts usr/lib/bootc/kargs.d's arguments in them. -->
    <select idref="xccdf_org.ssgproject.content_rule_grub2_audit_argument" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_grub2_audit_backlog_limit_argument" selected="false"/>
    <!-- Sysctls: each rule also reads the running kernel, in a build the build
         host's. The nodes check them. -->
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_fs_protected_hardlinks" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_fs_protected_symlinks" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_kernel_dmesg_restrict" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_kernel_kptr_restrict" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_kernel_randomize_va_space" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_kernel_yama_ptrace_scope" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_all_accept_redirects" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_default_accept_redirects" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_all_accept_source_route" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_default_accept_source_route" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_all_log_martians" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_default_log_martians" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_all_secure_redirects" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_default_secure_redirects" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_all_send_redirects" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_default_send_redirects" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_icmp_echo_ignore_broadcasts" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_icmp_ignore_bogus_error_responses" selected="false"/>
    <select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_tcp_syncookies" selected="false"/>
  </Profile>
</Tailoring>
