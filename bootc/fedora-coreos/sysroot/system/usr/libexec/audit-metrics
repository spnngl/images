#!/usr/bin/nu --no-config-file
# The audit subsystem's state, as metrics: the kernel's (auditctl -s, -l),
# auditd's (its state report), and counters of the logged events (aureport).
# See usr/lib/systemd/system/audit-metrics.service.
#
# Output, in /var/lib/audit-metrics:
#   audit.prom  for node-exporter's textfile collector: mount
#               /var/lib/audit-metrics into its pod, and give that path to
#               --collector.textfile.directory
#   state.nuon  ausearch's checkpoint, and the counters' totals up to it;
#               removed or unreadable, the next run counts the retained
#               logs again
#
# Nushell of Fedora's package (0.99): no syntax of a later release.

use /usr/share/nushell/prometheus.nu [metric one save-metrics]

const DIR = '/var/lib/audit-metrics'
const LOG_DIR = '/var/log/audit'
# RuntimeDirectory= of the service, which systemd removes after the run: raw
# audit records stay out of the folder node-exporter's pod mounts.
const CHECKPOINT = '/run/audit-metrics/checkpoint'
const INCREMENT = '/run/audit-metrics/increment.raw'
# Before the first run: no checkpoint, ausearch reads the retained logs.
const NO_STATE = {checkpoint: null, totals: []}
# The event counters: aureport's summary, and the label of its values.
# aureport -i names numbers: types, syscalls, users.
const REPORTS = [
    [flag name label help];
    ['-e' audit_events_total type 'Audit events, by record type.']
    ['-k' audit_rule_events_total key 'Audit events of the audit rules, by their key (-k).']
    ['-s' audit_syscall_events_total syscall 'Audit events of system calls, by system call.']
    ['-x' audit_executable_events_total exe 'Audit events, by executable: (null) for those without one.']
    ['-u' audit_user_events_total user 'Audit events, by login user: unset for tasks without a login.']
    ['-au' audit_authentications_total account 'Authentications (USER_AUTH), by account: unknown for one the node lacks.']
    ['-l' audit_logins_total account 'Logins (USER_LOGIN), by account: unknown for one the node lacks.']
    ['-a' audit_avc_total target_type 'SELinux access decisions (AVC), by target type: success granted, failed denied.']
]
# The counters' result label: an event's success=, res= or AVC decision; none
# for an event without one.
const RESULT_HELP = ' Result: success, failed, or none.'
# auditd rewrites it on SIGCONT (src/auditd.c, cont_handler()), from its event
# loop: after `auditctl --signal state` returns. Its last line, written, it is
# whole.
const STATE_REPORT = '/run/audit/auditd.state'
const STATE_REPORT_END = 'glibc fordblks '
const STATE_REPORT_TIMEOUT = 10sec
# The state report's lines, and their metric. A line auditd leaves out (no log
# written, the partition unreadable: src/auditd-event.c,
# write_logging_state()) gives no metric.
const DAEMON = [
    [line name help];
    ['writing to logs' auditd_writing_logs 'auditd writes its log: 1 yes, 0 no.']
    ['current log size' auditd_log_size_bytes "Size of auditd's current log."]
    ['max log size' auditd_log_max_size_bytes 'Size at which auditd rotates its log (max_log_file).']
    ['logs detected last rotate/shift' auditd_rotated_log_files 'Log files auditd counted at its last rotation.']
    ['Logging partition free space' auditd_disk_free_bytes "Free space of the log's partition."]
    ['space_left setting' auditd_space_left_bytes 'Free space of the log partition under which auditd takes its space_left_action.']
    ['admin_space_left setting' auditd_admin_space_left_bytes 'Free space of the log partition under which auditd takes its admin_space_left_action.']
    ['space left on partition' auditd_space_left "The log's partition had room at auditd's last write: 1 yes, 0 full."]
    ['logging suspended' auditd_logging_suspended 'auditd stopped writing its log (a full disk, a write error): 1 yes, 0 no.']
    ['file system space action performed' auditd_space_action_performed 'auditd took its space_left_action: 1 yes, 0 no.']
    ['admin space action performed' auditd_admin_space_action_performed 'auditd took its admin_space_left_action: 1 yes, 0 no.']
    ['disk error detected' auditd_disk_error 'auditd failed to write its log: 1 yes, 0 no.']
    ['Number of active plugins' auditd_plugins "auditd's plugins running."]
    ['current plugin queue depth' auditd_plugin_queue_depth "Events in auditd's queue to its plugins."]
    ['max plugin queue depth used' auditd_plugin_queue_max_depth "Most events in auditd's queue to its plugins since it started."]
    ['plugin queue size' auditd_plugin_queue_size "Events auditd's queue to its plugins holds at most (q_depth)."]
    ['plugin queue overflow detected' auditd_plugin_queue_overflow "auditd's queue to its plugins overflowed, events lost to them: 1 yes, 0 no."]
    ['plugin queueing suspended' auditd_plugin_queueing_suspended 'auditd stopped queueing events to its plugins: 1 yes, 0 no.']
    ['glibc arena' auditd_memory_arena_bytes "auditd's memory from the system (glibc's arena)."]
    ['glibc uordblks' auditd_memory_in_use_bytes "auditd's memory in use (glibc's uordblks)."]
    ['glibc fordblks' auditd_memory_free_bytes "auditd's memory free, kept from the system (glibc's fordblks)."]
]

def main [] {
    cd $DIR
    [
        ...(kernel)
        ...(daemon)
        ...(events)
        ...(oldest-event)
        ...((date now | format date '%s') | one
            | metric audit_metrics_last_run_timestamp_seconds 'Last run of audit-metrics.')
    ] | save-metrics audit.prom
}

# The kernel's state, and whether it has every rule: the rules' files say what
# should be audited, not what the kernel loaded.
def kernel []: nothing -> list<string> {
    # One `<key> <value>` a line; `loginuid_immutable 0 unlocked`.
    let status = ^auditctl -s | lines | parse --regex '^(?<key>\S+) (?<value>\S+)'
        | transpose --header-row --as-record
    let hz = hz
    # -a and -w lines: augenrules' file, then the kernel's.
    let rule = '^-[aw] '
    let written = open --raw /etc/audit/audit.rules | lines | where $it =~ $rule | length
    let loaded = ^auditctl -l | lines | where $it =~ $rule | length
    [
        ...($status.enabled? | one
            | metric audit_enabled 'Kernel audit: 0 off, 1 on, 2 on and its rules locked until reboot.')
        ...($status.failure? | one
            | metric audit_failure_mode 'What the kernel does when it loses an audit event: 0 nothing, 1 logs it, 2 panics.')
        ...($status.lost? | one
            | metric audit_lost_events_total --counter 'Audit events the kernel dropped since boot: its backlog full, the rate limit passed, no memory.')
        ...($status.backlog? | one
            | metric audit_backlog_events 'Audit events the kernel holds for auditd.')
        ...($status.backlog_limit? | one
            | metric audit_backlog_limit_events 'Audit events the kernel holds at most for auditd: past it, a process waits up to the backlog wait time, then its event is lost.')
        ...($status.rate_limit? | one
            | metric audit_rate_limit_events_per_second 'Audit events a second the kernel sends at most, 0 unlimited; past it, they are lost.')
        ...($status.backlog_wait_time? | seconds $hz | one
            | metric audit_backlog_wait_time_seconds 'How long a process waits for room in a full audit backlog before its event is lost.')
        ...($status.backlog_wait_time_actual? | seconds $hz | one
            | metric audit_backlog_wait_time_actual_seconds_total --counter 'Time processes waited for room in a full audit backlog, since boot.')
        ...($status.loginuid_immutable? | one
            | metric audit_loginuid_immutable 'Login uids, once set, can not change: 1 yes, 0 no.')
        ...($loaded | one
            | metric audit_rules 'Audit rules the kernel has.')
        ...(($written - $loaded) | one
            | metric audit_rules_rejected 'Audit rules of /etc/audit/audit.rules the kernel lacks: rejected at boot, they stay out until the next one (-c, -e 2).')
    ]
}

# The kernel's ticks a second, the unit of the backlog wait times
# (kernel/audit.c). Not `getconf CLK_TCK`: USER_HZ, another unit.
def hz []: nothing -> int {
    open --raw $'/usr/lib/modules/(^uname -r | str trim)/config' | lines
        | parse --regex '^CONFIG_HZ=(?<hz>\d+)$' | first | get hz | into int
}

# Jiffies as seconds; null stays null.
def seconds [hz: int]: any -> any {
    if $in == null { null } else { ($in | into int) / $hz }
}

# auditd's state report: its version, logging, plugin queue and memory. auditd
# stopped or hung gives auditd_up 0 and the other metrics still: the kernel's
# say whether it loses events meanwhile.
def daemon []: nothing -> list<string> {
    let report = state-report
    let up = (if $report == null { 0 } else { 1 }) | one
        | metric auditd_up 'auditd answered `auditctl --signal state` with its state report: 1 yes, 0 no.'
    if $report == null { return $up }
    let values = [
        ...($report | parse --regex '^(?<line>[^=]+?) = (?<value>.*)$')
        # `glibc arena (total memory) is: 2620 KiB, was: 0 KiB`: now, and at
        # the last report.
        ...($report | parse --regex '^(?<line>glibc \w+) .* is: (?<value>\d+ KiB),')
    ]
    [
        ...$up
        ...($values | where line == 'audit version' | each {|v| {labels: {version: $v.value}, value: 1} }
            | metric auditd_info 'auditd, with its version. Value: 1.')
        ...($DAEMON | each {|d|
            let value = $values | where line == $d.line
            if ($value | is-empty) { [] } else {
                $value | first | get value | number | one | metric $d.name $d.help
            }
        } | flatten)
    ]
}

# The lines of a state report auditd wrote after this call; null, with a
# warning, when auditd does not answer.
def state-report []: nothing -> any {
    let start = date now
    let signal = ^auditctl --signal state | complete
    if $signal.exit_code != 0 {
        print --stderr $"no auditd state report: `auditctl --signal state` exited ($signal.exit_code): ($signal.stderr | str trim)"
        return null
    }
    mut lines = []
    loop {
        if ($STATE_REPORT | path exists) and ((ls $STATE_REPORT | first | get modified) > $start) {
            $lines = open --raw $STATE_REPORT | lines
            if ($lines | is-not-empty) and ($lines | last | str starts-with $STATE_REPORT_END) { break }
        }
        if (date now) > ($start + $STATE_REPORT_TIMEOUT) {
            print --stderr $"no auditd state report in ($STATE_REPORT) ($STATE_REPORT_TIMEOUT) after `auditctl --signal state`"
            return null
        }
        sleep 100ms
    }
    $lines
}

# A state report's value as a number: yes and no as 1 and 0, KiB and MiB as
# bytes.
def number []: string -> int {
    let value = $in
    if $value == 'yes' { return 1 }
    if $value == 'no' { return 0 }
    let parsed = $value | parse --regex '^(?<n>\d+)(?: (?<unit>KiB|MiB))?$'
    if ($parsed | is-empty) {
        error make {msg: $"unexpected value in ($STATE_REPORT): ($value)"}
    }
    let n = $parsed | first
    let unit = match $n.unit { 'KiB' => 1024, 'MiB' => 1048576, _ => 1 }
    ($n.n | into int) * $unit
}

# Counters of the events logged since the last run (the increment), added to
# the totals of state.nuon. Not a report of the whole log: its counts drop at
# each rotation.
def events []: nothing -> list<string> {
    let loaded = load-state
    let found = increment $loaded.checkpoint
    let rejected = $found == null
    if $rejected {
        print --stderr $"ausearch rejects the checkpoint of ($DIR)/state.nuon: counting the retained logs again"
    }
    let state = if $rejected { $NO_STATE } else { $loaded }
    let found = if $rejected { increment null } else { $found }
    let counts = if $found {
        let accounts = ^getent passwd | lines | each {|l| $l | split row ':' | first }
        $REPORTS | each {|r| report $r $accounts } | flatten
    } else { [] }
    # By metric and labels.
    let totals = $state.totals | append $counts
        | group-by {|c| {name: $c.name, labels: $c.labels} | to nuon }
        | values
        | each {|c| {name: $c.0.name, labels: $c.0.labels, value: ($c.value | math sum)} }
    let checkpoint = open --raw $CHECKPOINT
    # The totals and the checkpoint they count up to change together: written
    # whole, then renamed.
    {checkpoint: $checkpoint, totals: $totals} | to nuon | save --force state.nuon.tmp
    mv --force state.nuon.tmp state.nuon
    [
        ...($REPORTS | each {|r|
            $totals | where name == $r.name | sort-by value --reverse
                | metric $r.name $"($r.help)($RESULT_HELP)" --counter
        } | flatten)
        # `output=<node> <epoch>.<ms>:<serial> <type>`; 0.000 before any event.
        ...($checkpoint | parse --regex 'output=\S+ (?<time>\d+\.\d+):'
            | where time != '0.000' | get time.0?
            | one | metric audit_last_event_timestamp_seconds 'Last audit event counted.')
    ]
}

# state.nuon, or NO_STATE when it is missing or unreadable (with a warning).
# Counting the retained logs again blocks no run; a counter can drop, which
# Prometheus reads as a reset.
def load-state []: nothing -> record {
    if not ('state.nuon' | path exists) { return $NO_STATE }
    try {
        let state = open state.nuon
        if ($state.checkpoint | describe) not-in [string nothing] {
            error make {msg: 'its checkpoint is not a string'}
        }
        {checkpoint: $state.checkpoint, totals: ($state.totals | select name labels value)}
    } catch {|e|
        print --stderr $"($DIR)/state.nuon unreadable, counting the retained logs again: ($e.msg)"
        $NO_STATE
    }
}

# The events after the checkpoint, raw, in INCREMENT: true; false for none;
# null when ausearch rejects the checkpoint (malformed). ausearch writes the
# checkpoint on success only.
def increment [checkpoint: any]: nothing -> any {
    rm --force $CHECKPOINT
    if $checkpoint != null { $checkpoint | save $CHECKPOINT }
    let search = {|start: list<string>|
        ^ausearch --input-logs --checkpoint $CHECKPOINT ...$start --raw | complete
    }
    mut out = do $search []
    # 10, 11, 12: the checkpoint's log or event left the logs (rotated). From
    # its time: an event of the same millisecond counts twice.
    if $out.exit_code in [10 11 12] { $out = do $search [--start checkpoint] }
    # Still rejected: a malformed checkpoint.
    if $checkpoint != null and $out.exit_code in [10 11 12] { return null }
    # 1, silent: no event since the checkpoint (src/ausearch.c, main()).
    if $out.exit_code == 1 and $out.stderr == '' { return false }
    if $out.exit_code != 0 {
        error make {msg: $"ausearch exited ($out.exit_code): ($out.stderr)"}
    }
    $out.stdout | save --force $INCREMENT
    true
}

# A report's counts of the increment, by value and result: rows of
# {name, labels, value}.
def report [r: record, accounts: list<string>]: nothing -> list<record> {
    let all = summary $r.flag []
    let success = summary $r.flag [--success]
    let failed = summary $r.flag [--failed]
    $all | each {|a|
        let s = $success | where value == $a.value | get total.0? | default 0
        let f = $failed | where value == $a.value | get total.0? | default 0
        let label = $a.value | label-value $r.label $accounts
        [[result value]; [success $s] [failed $f] [none ($a.total - $s - $f)]]
            | where value > 0
            | each {|c| {name: $r.name, labels: ({} | insert $r.label $label | insert result $c.result), value: $c.value} }
    } | flatten
}

# aureport's `<total>  <value>` lines; its title and header lines start
# otherwise.
def summary [flag: string, filter: list<string>]: nothing -> list<record> {
    let out = ^aureport -i -if $INCREMENT $flag --summary ...$filter | complete
    if $out.exit_code != 0 {
        error make {msg: $"aureport ($flag) ($filter | str join ' ') exited ($out.exit_code): ($out.stderr)"}
    }
    $out.stdout | lines | parse --regex '^(?<total>\d+)  (?<value>.+)$'
        | update total {|t| $t.total | into int }
}

# A label's value, bounded: an account the node lacks is the name an SSH
# client sent, any; an AVC target keeps its type, its MCS categories differ
# per container.
def label-value [label: string, accounts: list<string>]: string -> string {
    let value = $in
    match $label {
        'account' => (if $value in $accounts { $value } else { 'unknown' })
        'target_type' => ($value | split row ':' | get 2? | default $value)
        _ => $value
    }
}

# The first event of the oldest log: how far back the logs go.
def oldest-event []: nothing -> list<string> {
    let first = ls $LOG_DIR | where name =~ '/audit\.log(\.\d+)?$' | sort-by modified
        | each {|log| ^head -n 1 $log.name | parse --regex 'msg=audit\((?<time>\d+\.\d+):' }
        | flatten | get time.0?
    $first | one | metric audit_log_oldest_event_timestamp_seconds 'First event of the oldest audit log kept: how far back the logs go.'
}
