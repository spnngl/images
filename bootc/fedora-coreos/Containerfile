# syntax=docker.io/docker/dockerfile:1

# Fedora CoreOS release, with the stable stream's tag form. Every version
# below, this one, Kubernetes' and NVIDIA's, is set by
# bootc/fedora-coreos/docker-bake.hcl, which has no default to keep in sync.
# Tag of this image: <Fedora major>-v<Kubernetes minor>.
#
# Available tags: https://quay.io/repository/fedora/fedora-coreos?tab=tags
ARG BASE_VERSION

# Layers, each stage FROM the one before (REFERENCES.md, "Layers"):
# - system: the node's own packages and sysroot/system/;
# - kube: Kubernetes and sysroot/kube/, so that a Kubernetes release
#   rebuilds this stage alone;
# - image: the platforms' files (sysroot/vm/, sysroot/metal/), then what
#   reads the whole tree.
# The GPU image's stage, nvidia, sits between kube and image: the build
# arg IMAGE_BASE=nvidia puts it under image, and fedora-coreos's build
# never reaches it.
ARG IMAGE_BASE="kube"
FROM quay.io/fedora/fedora-coreos:${BASE_VERSION} AS system

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=UTC

SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

RUN <<EORUN
# Fedora's names for what image-builder install. The base already has jq, curl,
# mdadm, lvm2, cryptsetup, tpm2-tools, chrony, socat, iptables-nft and
# systemd-resolved. Kubernetes' own are in the kube stage.
# - systemd-networkd manages the network.
# - greenboot checks an update boots and rolls back when it doesn't.
# - openscap-scanner and scap-security-guide check the image (scan stage,
#   below) and the nodes (openscap.timer); audispd-plugins holds audit's
#   syslog plugin; nushell runs usr/libexec/openscap-scan and
#   usr/libexec/etc-diff, which write their results as metrics.
# - grype lists the CVEs of the image (scan stage, below) and of the nodes
#   (grype.timer).
#
# scap-security-guide holds about 40 products' content and the remediation
# scripts, 735 MB; the scans read Fedora's data stream alone, 21 MB. rpm skips
# the rest as net shared paths (exact paths), which `rpm -V` doesn't report
# missing.
ssg=/usr/share/xml/scap/ssg/content
skip="$(dnf -q repoquery --latest-limit=1 --list scap-security-guide |
    grep "^${ssg}/" | grep -vx "${ssg}/ssg-fedora-ds.xml" | paste -sd:)"
echo "%_netsharedpath /usr/share/scap-security-guide:${skip}" > /etc/rpm/macros.ssg

# No weak dependencies, as FCOS itself is built.
dnf -yq install --setopt=install_weak_deps=False \
    sysstat rootlesskit net-tools qemu-guest-agent greenboot \
    greenboot-default-health-checks systemd-networkd openscap-scanner scap-security-guide \
    audispd-plugins grype nushell

rm -f /etc/rpm/macros.ssg

# Updates come from Cluster API (a new machine) or bootc-operator, never from
# the node itself. moby-engine, docker-cli, toolbox: containerd is the runtime.
# podman stays: bootc requires it, and removing it would remove bootc,
# rpm-ostree and greenboot too. iptables-services: no host firewall, Cilium
# filters (FCOS has neither firewalld nor ufw; test/system/build.yaml checks).
dnf -yq remove zincati moby-engine docker-cli iptables-services toolbox

# CIS wants them gone: no node serves DNS or DHCP, nor copies with rsync.
# rpm -e, not dnf: it fails if another package requires them.
rpm -e dnsmasq rsync
# CIS wants rpcbind off. Only NFSv3 mounts need it, not NFSv4: its
# dependants go with it, mount.nfs stays (nfs-common-utils).
rpm -e rpcbind nfsv3-client-utils nfs-client-utils

# This file sets kernel.yama.ptrace_scope to 0, against 990-cis.conf, and
# CIS reads every sysctl.d file. Its package stays: elfutils-libs requires it.
rm /usr/lib/sysctl.d/10-default-yama-scope.conf

# NetworkManager's extras. NetworkManager itself stays installed but masked
# (below): ignition, dracut-network, afterburn-dracut and kdump-utils
# require it, and FCOS's initramfs runs it to fetch the Ignition config.
# ModemManager isn't installed.
dnf -yq remove nmstate NetworkManager-team NetworkManager-tui NetworkManager-cloud-setup

# chrony.conf has no include directory: replace its default pool with a
# sources directory, filled by etc/chrony/sources.d/. Fail if the pool line
# was not found.
sed -i 's|^pool .*|sourcedir /etc/chrony/sources.d|' /etc/chrony.conf
grep -qx 'sourcedir /etc/chrony/sources.d' /etc/chrony.conf

# No core user: FCOS's initramfs creates it with Ignition (00-core.ign of
# dracut module ignition-conf), and enables afterburn-sshkeys@core
# (ignition-conf-fcos, also NetworkManager-cloud-setup on AWS, Azure and
# GCP, removed above). rootless is the only login. The arguments are the
# base's (usr/lib/dracut/build-parameter.txt).
kver="$(ls /usr/lib/modules)"
dracut --force --reproducible --no-hostonly --omit 'ignition-conf ignition-conf-fcos' \
    --tmpdir /tmp --kver "${kver}" "/usr/lib/modules/${kver}/initramfs.img"

# /var ships empty.
dnf -yq clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf* /run/selinux-policy
# State directories the packages ship: sysstat's pcp-libs and audisp-remote
# create theirs at runtime.
rm -rf /var/lib/pcp /var/lib/rpm-state /var/lib/systemd/migrated /var/spool/audit
# moby-engine's group, left behind by its removal.
if getent group docker >/dev/null; then groupdel docker; fi
EORUN

# Our policy.json, about to replace the base's, must still be the base's
# plus our changes (policy.jq).
# After the packages, so that editing sysroot/ keeps their layer cached.
RUN --mount=type=bind,source=policy.jq,target=/tmp/policy.jq \
    --mount=type=bind,source=sysroot/system/etc/containers/policy.json,target=/tmp/policy.json \
    jq -e --slurpfile ours /tmp/policy.json -f /tmp/policy.jq /etc/containers/policy.json

# Units are enabled by links in /usr/lib, committed in each layer's
# sysroot/, not by `systemctl enable` (/etc): FCOS runs `systemctl
# preset-all` at first boot, which removes the /etc links that no preset
# names. Each link is what the unit's [Install] section asks for
# (greenboot's: usr/lib/systemd/system of greenboot-rs), but
# systemd-network-generator.service, networkd's, which the base enables.
# test/system/build.yaml checks that no link dangles.
COPY --link ./sysroot/system/ /

RUN <<EORUN
# COPY keeps a file's mode, and git only stores the executable bit. It also
# gives its folders 0755: the packages' modes come back.
chmod 0750 /etc/sudoers.d
chmod 0700 /etc/ssh/sshd_config.d
# The base's drop-ins too: CIS wants them 0600.
chmod 0600 /etc/ssh/sshd_config.d/*.conf
# 00-hardening.conf's `GSSAPIAuthentication no` wins, but OpenSCAP wants every
# line to say so: Fedora's `yes` goes. Fail if it was not found.
grep -qx 'GSSAPIAuthentication yes' /etc/ssh/sshd_config.d/50-redhat.conf
sed -i '/^GSSAPIAuthentication yes$/d' /etc/ssh/sshd_config.d/50-redhat.conf
chmod 0440 /etc/sudoers.d/{00-defaults,99-rootless}
visudo -c
chmod 0755 /usr/libexec/{wx-remount,openscap-scan,etc-diff,grype-scan}

# SELinux permissive, containerd runs with enable_selinux = false. It still labels files and logs denials.
# TODO add it back ?
sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config
grep -qx 'SELINUX=permissive' /etc/selinux/config

# No login with an empty password. The base's authselect profile stays,
# `local`: SSSD has no provider for local users. /var ships empty, as the
# base's: authselect checks its files without the checksum it writes there.
authselect enable-feature without-nullok
test -z "$(grep -l nullok /etc/pam.d/system-auth /etc/pam.d/password-auth)"
rm -rf /var/lib/authselect
authselect check

# CIS's umask, 027, where no drop-in can set it: login.defs (useradd, PAM),
# and bashrc's fallback for a shell started with umask 0 (etc/profile.d/umask.sh
# sets the rest). Fail if a line was not found.
sed -i -E 's/^UMASK(\s+)022$/UMASK\1027/' /etc/login.defs
grep -qE '^UMASK\s+027$' /etc/login.defs
sed -i 's/&& umask 022$/\&\& umask 027/' /etc/bashrc
grep -q '&& umask 027$' /etc/bashrc

# Audit events to the journal too. Fail if the plugin's line was not found.
sed -i 's/^active = no$/active = yes/' /etc/audit/plugins.d/syslog.conf
grep -qx 'active = yes' /etc/audit/plugins.d/syslog.conf

# Audit rules: etc/audit/rules.d/. Fedora's audit.rules turns syscall
# auditing off (-a task,never). 51-cis-x86_64.rules names syscalls only
# x86_64 has.
rm /etc/audit/rules.d/audit.rules
if [[ "$(uname -m)" != x86_64 ]]; then rm /etc/audit/rules.d/51-cis-x86_64.rules; fi
chmod 0750 /etc/audit/rules.d
chmod 0640 /etc/audit/rules.d/*.rules

# systemd-networkd, not NetworkManager: the base enables NetworkManager in
# /etc, and masking keeps preset-all from enabling it again.
systemctl disable NetworkManager.service NetworkManager-wait-online.service
rm -rf /etc/systemd/system/NetworkManager.service.wants
systemctl mask NetworkManager.service NetworkManager-wait-online.service \
    NetworkManager-dispatcher.service nm-priv-helper.service

# Not used. systemd-homed-activate too: preset-all would enable it, linking
# it into the masked unit's wants in /etc.
systemctl disable systemd-homed.service systemd-homed-activate.service
systemctl mask systemd-homed.service systemd-homed-activate.service

rm -rf /tmp/*
EORUN

FROM system AS kube

# Inherited from system; repeated for hadolint, which reads one stage back.
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# Kubernetes patch release of kubelet, kubeadm and kubectl.
ARG KUBERNETES_VERSION

RUN <<EORUN
# Kubernetes RPMs: https://kubernetes.io/docs/setup/production-environment/tools/kubeadm/install-kubeadm/
# One repository per minor release. Removed below: the image is not
# updated with dnf, a new Kubernetes patch is a new image.
minor="${KUBERNETES_VERSION%.*}"
cat > /etc/yum.repos.d/kubernetes.repo <<EOF
[kubernetes]
name=Kubernetes v${minor}
baseurl=https://pkgs.k8s.io/core:/stable:/v${minor}/rpm/
enabled=1
gpgcheck=1
gpgkey=https://pkgs.k8s.io/core:/stable:/v${minor}/rpm/repodata/repomd.xml.key
EOF

# What kubeadm and the node's units need: conntrack-tools (kubeadm's
# preflight), iproute-tc (etcd-network-tuning). No weak dependencies, as
# FCOS itself is built.
dnf -yq install --setopt=install_weak_deps=False \
    "kubelet-${KUBERNETES_VERSION}" "kubeadm-${KUBERNETES_VERSION}" "kubectl-${KUBERNETES_VERSION}" \
    cri-tools conntrack-tools iproute-tc

rm -f /etc/yum.repos.d/kubernetes.repo

# The base's /opt is /var/opt, and /var ships empty. kubernetes-cni (a kubelet
# dependency) drops the CNI plugins there: Cilium installs its own at
# runtime, and containerd's loopback is built in (use_internal_loopback).
rm -rf /opt
ln -s /var/opt /opt

# /var ships empty. kubelet creates its state directory at runtime; the
# packages' scriptlets bring back systemd's migrated/ and rpm-state/.
dnf -yq clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf* /var/lib/kubelet \
    /var/lib/rpm-state /var/lib/systemd/migrated
EORUN

COPY --link ./sysroot/kube/ /

RUN <<EORUN
chmod 0755 /usr/libexec/etcd-network-tuning.sh /usr/libexec/etcd-defrag
chmod 0755 /usr/lib/greenboot/check/required.d/*.sh

# The RPMs ship no bash completion, which etc/profile.d/kubernetes.sh loads.
for tool in kubectl kubeadm crictl; do
    "${tool}" completion bash > "/usr/share/bash-completion/completions/${tool}"
done

# kubelet tries to create it, and /usr is read-only at runtime.
mkdir -p /usr/libexec/kubernetes/kubelet-plugins/volume/exec

# containerd's base spec for containers, from `ctr oci spec`, with a higher
# open-files limit (what capi-image-builder's cri-base.json does).
ctr oci spec \
    | jq '.process.rlimits = [{"type": "RLIMIT_NOFILE", "hard": 65535, "soft": 65535}]' \
    > /usr/lib/containerd/cri-base.json

# The sandbox image kubeadm of this release expects, so that kubelet and
# containerd agree on it (kubeadm warns otherwise).
pause="$(kubeadm config images list --kubernetes-version "v${KUBERNETES_VERSION}" | grep '/pause:')"
cat > /usr/lib/containerd/conf.d/20-pause.toml <<EOF
[plugins.'io.containerd.cri.v1.images'.pinned_images]
  sandbox = '${pause}'
EOF

rm -rf /tmp/*
EORUN

# NVIDIA's open kernel modules, built for the base's kernel, as an RPM: the
# compiler and kernel headers stay in this stage, out of the GPU image
# (REFERENCES.md, "GPU image"). FROM the base, not system: the system stage
# leaves the kernel as it is, and BuildKit builds this stage alongside
# system and kube.
FROM quay.io/fedora/fedora-coreos:${BASE_VERSION} AS nvidia-kmod

SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

ARG NVIDIA_VERSION

# A throwaway stage: no dnf clean, only /rpms is used. NVIDIA's repositories
# (nvidia.repo): the DKMS package is the driver's source, which dkms builds
# below.
# hadolint ignore=DL3040
RUN --mount=type=bind,source=nvidia.repo,target=/etc/yum.repos.d/nvidia.repo \
    <<EORUN
kver="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core)"

# kernel-devel of the base's kernel: Fedora's updates, or their archive when
# the kernel is no longer the newest; Koji when FCOS ships a kernel before
# it reaches them (a fast-tracked fix). The base has no kernel-devel.
dnf -yq install --setopt=install_weak_deps=False "kernel-devel-${kver}" ||
    dnf -yq install --setopt=install_weak_deps=False \
        "https://kojipkgs.fedoraproject.org/packages/kernel/$(rpm -q --qf '%{VERSION}/%{RELEASE}/%{ARCH}' kernel-core)/kernel-devel-${kver}.rpm"
dnf -yq install --setopt=install_weak_deps=False \
    dkms make rpm-build "kmod-nvidia-open-dkms-3:${NVIDIA_VERSION}"

dkms build -m nvidia -v "${NVIDIA_VERSION}" -k "${kver}"

# The modules, where depmod finds them, as an RPM for the image: it provides
# nvidia-kmod, which the driver's nvidia-kmod-common requires, at the same
# version (epoch 3, as NVIDIA's packages). No debuginfo, no strip: the
# modules go as built.
stage="/tmp/stage/usr/lib/modules/${kver}/extra/nvidia"
mkdir -p "${stage}" /rpms
find "/var/lib/dkms/nvidia/${NVIDIA_VERSION}/${kver}" -name '*.ko*' -exec cp -t "${stage}" {} +

# What the image needs: each module there, built for this kernel, none of the
# proprietary ones (their licence says "NVIDIA"; the open ones' differ:
# Dual MIT/GPL, Dual BSD/GPL for peermem). The licences go in the build log.
for m in nvidia nvidia-drm nvidia-modeset nvidia-peermem nvidia-uvm; do
    f="$(find "${stage}" -name "${m}.ko*")"
    test -n "${f}"
    modinfo -F vermagic "${f}" | grep -q "^${kver} "
    license="$(modinfo -F license "${f}")"
    echo "${m}: ${license}"
    test "${license}" != NVIDIA
done

cat > /tmp/nvidia-kmod-open.spec <<EOF
%global debug_package %{nil}
%global __os_install_post %{nil}
%global _build_id_links none
Name: nvidia-kmod-open
Epoch: 3
Version: ${NVIDIA_VERSION}
Release: 1
Summary: NVIDIA open kernel modules, built for the image's kernel
License: (MIT OR GPL-2.0-only) AND (BSD-2-Clause OR GPL-2.0-only)
Provides: nvidia-kmod = 3:${NVIDIA_VERSION}
Requires: kernel-core-uname-r = ${kver}
%description
The modules dkms built from kmod-nvidia-open-dkms for ${kver}.
%install
cp -a /tmp/stage/. %{buildroot}/
%files
/usr/lib/modules/${kver}/extra/nvidia
EOF
rpmbuild -bb --define '_topdir /tmp/rpmbuild' /tmp/nvidia-kmod-open.spec
cp /tmp/rpmbuild/RPMS/*/nvidia-kmod-open-*.rpm /rpms/
EORUN

# The GPU image (REFERENCES.md, "GPU image"): built with
# --build-arg IMAGE_BASE=nvidia.
FROM kube AS nvidia

# Inherited; repeated for hadolint.
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

ARG NVIDIA_VERSION
ARG NVIDIA_CONTAINER_TOOLKIT_VERSION

# The modules of the nvidia-kmod stage (a bind mount, not COPY: the RPM stays
# out of the layers), the driver's compute userspace (nvidia-smi, the NVML and
# CUDA driver libraries, nvidia-persistenced) and the Container Toolkit's
# runtime and CDI tools. No graphics, no CUDA toolkit: the workloads' images
# carry their CUDA. NVIDIA's repositories: nvidia.repo, bind-mounted.
RUN --mount=type=bind,from=nvidia-kmod,source=/rpms,target=/run/rpms \
    --mount=type=bind,source=nvidia.repo,target=/etc/yum.repos.d/nvidia.repo \
    <<EORUN
kver="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core)"

# Its kernel modules are signed with a key nothing trusts, which
# lockdown=integrity refuses to load: the GPU image has no lockdown
# (REFERENCES.md, "GPU image").
rm /usr/lib/bootc/kargs.d/10-lockdown.toml

# nvidia-persistenced's sysusers.d file makes the install run systemd-sysusers,
# which writes every user of the image into /etc, rootless too (without its
# home: OpenSCAP's accounts_user_interactive_home_directory_exists fails).
# The image's users are made at boot, from sysusers.d: /etc's account files
# go back as they were after the install. No file belongs to
# nvidia-persistenced.
accounts="/etc/passwd /etc/group /etc/shadow /etc/gshadow"
mkdir /tmp/accounts
for f in ${accounts}; do cp -a "${f}" /tmp/accounts/; done

# The modules first: the driver's packages require nvidia-kmod, which only the
# stub RPM provides.
dnf -yq install --setopt=install_weak_deps=False \
    /run/rpms/nvidia-kmod-open-*.rpm \
    "nvidia-driver-cuda-3:${NVIDIA_VERSION}" \
    "nvidia-container-toolkit-base-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"
depmod -a "${kver}"

# The build tools stay in nvidia-kmod: a node has no use for them, and their
# presence means a package pulled them in.
for p in dkms gcc kernel-devel; do
    if rpm -q --quiet "${p}"; then
        echo "${p} is installed" >&2
        exit 1
    fi
done

for f in ${accounts}; do rm -f "${f}" "${f}-"; done
cp -a /tmp/accounts/. /etc/

# /var ships empty (as the kube stage); nvidia-driver-selinux's policy
# install leaves its state in /run and semanage's locks in /etc.
dnf -yq clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf* /var/lib/rpm-state /var/lib/systemd/migrated \
    /run/selinux-policy /etc/selinux/targeted/semanage.*.LOCK
EORUN

COPY --link ./sysroot/nvidia/ /

RUN chmod 0755 /usr/lib/greenboot/check/required.d/30-nvidia.sh

FROM ${IMAGE_BASE} AS image

# Inherited; repeated for hadolint.
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# The platforms' files: each one's units skip the others (their
# conditions).
COPY --link ./sysroot/vm/ /
COPY --link ./sysroot/metal/ /

RUN <<EORUN
chmod 0755 /usr/libexec/{openstack-fetch-metadata,openstack-disk-by-tag}

# CIS 6.3.3.10: each setuid or setgid program, all in /usr (the image's),
# its own rule; the check wants exactly those. Here, once every layer's
# packages are in.
find /usr -xdev -type f -perm /6000 | sort | while read -r f; do
    for a in b32 b64; do
        echo "-a always,exit -F arch=${a} -F path=${f} -F perm=x -F auid>=1000 -F auid!=unset -k privileged"
    done
done > /etc/audit/rules.d/52-privileged.rules
test -s /etc/audit/rules.d/52-privileged.rules
chmod 0640 /etc/audit/rules.d/52-privileged.rules
EORUN

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint

# Scans of the image, in a stage of their own so that their files stay out of
# the image. They report what they find; the check stage judges.
FROM image AS scan
RUN --mount=type=cache,target=/var/cache/grype \
    <<EORUN
# OpenSCAP, profile `build` of the tailoring (sysroot/system/usr/share/xml/scap/):
# what a build can check. Exit 2: rules failed, the report is written.
# BuildKit only: podman's /run/.containerenv turns the machine rules off.
# /run/ostree-booted, as on a node, makes scap-security-guide see a bootc
# system: OpenSCAP does not find its other sign, the /ostree symlink, so it
# would count the setuid files of /sysroot/ostree/repo as programs
# (audit_rules_privileged_commands).
touch /run/ostree-booted
mkdir -p /reports/openscap /reports/grype
oscap xccdf eval --profile xccdf_local_profile_build \
    --tailoring-file /usr/share/xml/scap/fedora-coreos/tailoring.xml \
    --results /reports/openscap/results.xml --report /reports/openscap/report.html \
    /usr/share/xml/scap/ssg/content/ssg-fedora-ds.xml || [[ $? == 2 ]]
# grype, as the nodes run it. The cache keeps its database between builds.
STATE_DIRECTORY=/reports/grype CACHE_DIRECTORY=/var/cache/grype /usr/libexec/grype-scan
EORUN

# goss, from Fedora's package, in a stage of its own: the goss stage mounts
# its binary alone, so that neither the image nor the scans see it. Same
# Fedora release as the image, so the image's glibc runs it. FROM system:
# a Kubernetes release keeps it cached.
FROM system AS goss-bin
# No dnf clean: a throwaway stage, only its goss binary is used.
# hadolint ignore=DL3040
RUN dnf -yq install goss

# Checks of the image's files (test/build.yaml, which includes each
# layer's; test/<IMAGE_BASE>-build.yaml includes that one and adds the image's).
# Exit 1: checks failed, the report is written; the check stage judges.
FROM image AS goss
ARG IMAGE_BASE

# Inherited; repeated for hadolint, which loses it at an ARG.
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

RUN --network=none \
    --mount=type=bind,from=goss-bin,source=/usr/bin/goss,target=/run/goss/goss \
    --mount=type=bind,source=test,target=/run/goss/test \
    <<EORUN
mkdir -p /reports/goss
/run/goss/goss --gossfile "/run/goss/test/${IMAGE_BASE}-build.yaml" validate --format tap \
    > /reports/goss/build.tap || [[ $? == 1 ]]
EORUN

# The verdict on the reports: a failed OpenSCAP rule, a fixable Critical
# vulnerability or a failed goss check. It never fails the build, so that the
# reports are exported either way: it writes summary.txt, and failed, only
# when something failed, for the caller to stop on (the build-bootc.yml
# workflow, and bootc/fedora-coreos/AGENTS.md's build check, which print it).
# grype.prom holds the fixable vulnerabilities of Medium severity and above.
# FROM system: tools the image has, none of its files.
FROM system AS check

# Inherited; repeated for hadolint.
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

RUN --network=none \
    --mount=type=bind,from=scan,source=/reports,target=/scan \
    --mount=type=bind,from=goss,source=/reports,target=/goss \
    <<EORUN
mkdir -p /reports
failed=""
{
    # Rules out of the profile are `notselected`.
    grep -o '<result>[a-z]*</result>' /scan/openscap/results.xml | awk -F '[<>]' '
        $3 != "notselected" { n[$3]++ }
        END { printf "OpenSCAP:"; for (r in n) printf " %d %s", n[r], r; print "" }'
    awk -F '"' '/^grype_vulnerability\{/ { n[$4]++ }
        END { printf "grype, fixable:"; for (s in n) printf " %d %s", n[s], s; print "" }' /scan/grype/grype.prom
    # TAP: a plan line `1..<count>`, then `ok` or `not ok` per check. goss
    # writes no plan when it can't read the suite.
    awk '/^ok / { ok++ } /^not ok / { nok++ } END { printf "goss: %d ok, %d not ok\n", ok, nok }' /goss/goss/build.tap
    grep '^not ok ' /goss/goss/build.tap || true
} > /reports/summary.txt
if grep -qE '<result>(fail|error)</result>' /scan/openscap/results.xml; then
    failed+=" OpenSCAP rules failed: openscap/report.html."
fi
if grep -q '^grype_vulnerability{.*severity="Critical"' /scan/grype/grype.prom; then
    failed+=" Fixable Critical vulnerabilities: grype/grype.prom."
fi
if ! grep -qE '^1\.\.[1-9]' /goss/goss/build.tap; then
    failed+=" goss ran no check: goss/build.tap."
elif grep -q '^not ok ' /goss/goss/build.tap; then
    failed+=" goss checks failed: goss/build.tap."
fi
if [[ -n ${failed} ]]; then
    echo "${failed# }" > /reports/failed
fi
EORUN

# The reports alone, and the verdict:
# `--target reports --output type=local,dest=<dir>`.
FROM scratch AS reports
COPY --from=scan /reports/ /
COPY --from=goss /reports/ /
COPY --from=check /reports/ /

# The image, last: the default target.
FROM image
