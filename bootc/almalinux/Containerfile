# syntax=docker.io/docker/dockerfile:1

# Derived AlmaLinux bootc image, with geo-blocking. Stages and build
# commands: bootc/AGENTS.md.
# Docs: https://bootc.dev/bootc/building/guidance.html

# Base image major release, also the tag of this image. CI sets it with
# --build-arg (.github/workflows/build-bootc.yml); keep this default in sync.
# Available tags: https://quay.io/repository/almalinuxorg/almalinux-bootc?tab=tags
ARG BASE_VERSION=10

# Build-only stage: downloads the geo-blocking data of every country and
# 10 public threat feeds, then turns the blocked countries and the feeds
# into compacted firewalld ipsets under /out with geoblock.nu. Only /out
# reaches the final image.
#
# ADD, not RUN curl: buildah puts the digest of the downloaded content in
# the build cache key, so only changed data reruns the steps below.
#
# The output is plain data, the same for every platform.
FROM --platform=${BUILDPLATFORM} ghcr.io/nushell/nushell:0.116.1-alpine AS geoblock

# The nushell image runs as user "nushell": switch back to root so the
# RUN below can write /out, and its output is owned by root like the rest
# of the final image. This stage is never run as a container.
# hadolint ignore=DL3002
USER 0
# RUN takes nushell code directly. No config file: the build must not
# depend on the image's default config.
SHELL ["/usr/bin/nu", "--no-history", "--no-config-file", "-c"]

# The IPv4 zones of every country, from ipdeny, one <code>.zone per
# country: the blocked ones are picked in the RUN below. Not aggregated
# (US: 70 K networks), geoblock.nu compacts them. Stays an archive: ADD
# only unpacks local ones. IPv4 only: IPv6 is disabled.
ADD --chmod=0644 \
    https://www.ipdeny.com/ipblocks/data/countries/all-zones.tar.gz /geoblock/
# AbuseIPDB 100 % confidence score, last 24 h (~67 K)
ADD --chmod=0644 \
    https://raw.githubusercontent.com/borestad/blocklist-abuseipdb/refs/heads/main/abuseipdb-s100-1d.ipv4 /out/usr/share/geoblock/blocklists/abuseipdb.txt
# FireHOL level 1 -- aggregated worst-of-the-worst netsets (~4.5 K)
ADD --chmod=0644 \
    https://iplists.firehol.org/files/firehol_level1.netset /out/usr/share/geoblock/blocklists/firehol-level1.txt
# IPsum threat level >= 5 -- consensus across 5+ blacklists (~3.5 K)
ADD --chmod=0644 \
    https://raw.githubusercontent.com/stamparm/ipsum/refs/heads/master/levels/5.txt /out/usr/share/geoblock/blocklists/ipsum-level5.txt
# Binary Defense ban list -- active attackers (~8 K)
ADD --chmod=0644 \
    https://binarydefense.com/banlist.txt /out/usr/share/geoblock/blocklists/binarydefense.txt
# Spamhaus DROP -- hijacked/leased netblocks (~1.6 K CIDRs)
ADD --chmod=0644 \
    https://www.spamhaus.org/drop/drop.txt /out/usr/share/geoblock/blocklists/spamhaus-drop.txt
# Romain Marcoux -- aggregated malicious IPs (40 K)
ADD --chmod=0644 \
    https://raw.githubusercontent.com/romainmarcoux/malicious-ip/refs/heads/main/full-40k.txt /out/usr/share/geoblock/blocklists/malicious-ip.txt
# Data-Shield -- critical threat IPs (~101 K)
ADD --chmod=0644 \
    https://raw.githubusercontent.com/duggytuxy/Data-Shield_IPv4_Blocklist/refs/heads/main/prod_critical_data-shield_ipv4_blocklist.txt /out/usr/share/geoblock/blocklists/data-shield.txt
# CINS Army -- top attackers by CINS score (~15 K)
ADD --chmod=0644 \
    https://cinsscore.com/list/ci-badguys.txt /out/usr/share/geoblock/blocklists/cinsscore.txt
# blocklist.de -- fail2ban aggregated list (~22 K)
ADD --chmod=0644 \
    https://lists.blocklist.de/lists/all.txt /out/usr/share/geoblock/blocklists/blocklist-de.txt
# Emerging Threats -- known compromised IPs
ADD --chmod=0644 \
    https://rules.emergingthreats.net/blockrules/compromised-ips.txt /out/usr/share/geoblock/blocklists/emerging-threats.txt
COPY almalinux/geoblock.nu almalinux/test_geoblock.nu /geoblock/
# The static bogon ipset: geoblock.nu fails on a country network that
# overlaps it.
COPY almalinux/sysroot/common/usr/lib/firewalld/ipsets/geoblock-bogons.xml /geoblock/bogons/

# geoblock.nu is the only check of ipset entries (bootc/REFERENCES.md,
# "Firewalld"): its tests run here, before it runs on the real data.
# `use x.nu` makes x.nu's main the command `x`.
WORKDIR /geoblock
# ShellCheck, which hadolint runs on RUN, does not know nushell.
# hadolint ignore=SC1008,SC2086
RUN <<EORUN
mkdir zones
^tar -xzf all-zones.tar.gz -C zones

use test_geoblock.nu
use geoblock.nu

test_geoblock

# Blocked countries, ISO 3166-1 alpha-2 codes; geoblock.nu fails on a code
# with no zone. Not the US: geolocation is by address registration
# (bootc/almalinux/REFERENCES.md).
let countries = [
    ad  # Andorra
    af  # Afghanistan
    az  # Azerbaijan
    bd  # Bangladesh
    br  # Brazil
    by  # Belarus
    cn  # China
    cu  # Cuba
    gh  # Ghana
    gy  # Guyana
    hk  # Hong Kong
    id  # Indonesia
    il  # Israel
    in  # India
    iq  # Iraq
    ir  # Iran
    kp  # North Korea
    kz  # Kazakhstan
    mm  # Myanmar
    mo  # Macao
    ng  # Nigeria
    pk  # Pakistan
    ru  # Russia
    sy  # Syria
    tr  # Turkey
    ua  # Ukraine
    uz  # Uzbekistan
    ve  # Venezuela
    vn  # Vietnam
    ye  # Yemen
    za  # South Africa
]
geoblock zones /out/usr/share/geoblock/blocklists bogons /out ...$countries
EORUN


# The host system, shared by dockerenv and kubeenv.
FROM quay.io/almalinuxorg/almalinux-bootc:${BASE_VERSION} AS base

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=UTC

SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# Our policy.json, about to replace the base's, must still be the base's
# plus our changes (fedora/policy.jq). AlmaLinux 9's differs from 10's, so
# ours is per release (sysroot/<BASE_VERSION>/); a new release has none yet
# and fails here.
ARG BASE_VERSION
RUN --mount=type=bind,source=fedora/policy.jq,target=/tmp/policy.jq \
    --mount=type=bind,source=almalinux/sysroot,target=/tmp/sysroot \
    jq -e --slurpfile ours "/tmp/sysroot/${BASE_VERSION}/etc/containers/policy.json" \
        -f /tmp/policy.jq /etc/containers/policy.json

# Keep the build context's modes (0755 directories, 0644 files). No --chmod:
# buildah applies it to directories too, and 0644 on /usr, /etc... breaks
# every non-root service (systemd-resolved included). Not fedora's
# release-specific files.
COPY --link ./fedora/sysroot/common/ /

# Geo-blocking and blocklist ipsets built in the "geoblock" stage above.
# This must come before the policies below: a policy that references a
# missing ipset makes every firewall-offline-cmd call fail.
COPY --link --from=geoblock /out/ /
# Geo-blocking policies and the static bogon ipsets they use, shared by
# every release.
COPY --link ./almalinux/sysroot/common/ /
# Release-specific files (policy.json).
COPY --link ./almalinux/sysroot/${BASE_VERSION}/ /

RUN <<EORUN
dnf -yq install ca-certificates dnf-plugins-core epel-release \
    glibc-langpack-en glibc-langpack-fr

# Needs EPEL.
dnf -yq install \
    sysstat iproute iputils procps-ng util-linux coreutils \
    e2fsprogs mdadm lvm2 cryptsetup tree htop btrfs-progs firewalld \
    netcat vim git nftables podman buildah \
    systemd-networkd systemd-resolved containers-common

ln -sf ../usr/share/zoneinfo/Europe/Paris /etc/localtime

# chrony.conf has no include directory: replace its default pool with a
# sources directory, filled by etc/chrony/sources.d/. Fail if the pool line
# was not found.
sed -i 's|^pool .*|sourcedir /etc/chrony/sources.d|' /etc/chrony.conf
grep -qx 'sourcedir /etc/chrony/sources.d' /etc/chrony.conf

# Firewall: HTTP(S), and sshd on 42022 (etc/ssh/sshd_config.d/10-myssh.conf).
# TODO selinux one day
firewall-offline-cmd --add-port=80/tcp --add-port=443/tcp --add-port=42022/tcp
firewall-offline-cmd --zone=public --remove-service-from-zone=cockpit --remove-service-from-zone=ssh
firewall-offline-cmd --check-config

systemctl disable NetworkManager
systemctl mask NetworkManager
systemctl enable sshd.service firewalld.service \
    systemd-resolved.service systemd-networkd.service \
    mdmonitor.service

# /var ships empty.
dnf -yq autoremove
dnf -yq clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN


# k3s, without Docker. Steps and reasons: bootc/k3s/install.sh; host setup:
# bootc/K3S.md.
FROM base AS kubeenv

# k3s release (its tag), which sets Kubernetes' and CRI-O's. CI sets it
# with --build-arg (.github/workflows/build-bootc.yml); keep this default in sync.
ARG INSTALL_K3S_VERSION=v1.37.1+k3s1

# Bind-mounted, not copied: the script stays out of the image.
RUN --mount=type=bind,source=k3s,target=/k3s \
    bash /k3s/install.sh

# After the install, so that editing sysroot/ doesn't rerun it.
COPY --link ./k3s/sysroot/ /

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint


# Docker. Last stage, so the default target.
FROM base AS dockerenv

RUN <<EORUN
# Docker's CentOS repository: it has every package.
dnf-3 config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo

dnf -yq install docker-ce docker-ce-cli containerd.io docker-buildx-plugin \
    docker-compose-plugin docker-model-plugin

systemctl enable docker.service containerd.service

# /var ships empty.
dnf -yq autoremove
dnf -yq clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint
