{
    "default": [
        {
            "type": "reject"
        }
    ],
    "transports": {
        "docker": {
            "ghcr.io/spnngl/images": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/usr/share/pki/containers/spnngl-images.pub"
                }
            ],
            "registry.access.redhat.com": [
                {
                    "type": "signedBy",
                    "keyType": "GPGKeys",
                    "keyPaths": [
                        "/etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release",
                        "/etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-beta"
                    ]
                }
            ],
            "registry.redhat.io": [
                {
                    "type": "signedBy",
                    "keyType": "GPGKeys",
                    "keyPaths": [
                        "/etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release",
                        "/etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-beta"
                    ]
                }
            ],
            "": [{ "type": "insecureAcceptAnything" }]
        },
        "containers-storage": { "": [{ "type": "insecureAcceptAnything" }] },
        "dir": { "": [{ "type": "insecureAcceptAnything" }] },
        "docker-archive": { "": [{ "type": "insecureAcceptAnything" }] },
        "docker-daemon": { "": [{ "type": "insecureAcceptAnything" }] },
        "oci": { "": [{ "type": "insecureAcceptAnything" }] },
        "oci-archive": { "": [{ "type": "insecureAcceptAnything" }] },
        "sif": { "": [{ "type": "insecureAcceptAnything" }] },
        "tarball": { "": [{ "type": "insecureAcceptAnything" }] }
    }
}
