# syntax=docker.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

# A Flux toolbox: flux (with its schema plugin), flux-operator, kustomize,
# kubectl, helm, sops and nushell (with its plugins) on this repository's
# git image, so with git, ssh and busybox's shell. For CI jobs and
# Kubernetes jobs that render, validate, diff or apply what Flux deploys,
# and scripts that bootstrap it. flux, flux-schema, flux-operator,
# kustomize and nushell are upstream's release binaries, from GitHub
# releases, each checked against its release's checksum file; sops is
# built from its tag with the current Go (its release binary's Go has a
# critical fixed vulnerability); kubectl and helm come from this
# repository's kubectl and kustomize images (neither project publishes a
# GitHub release binary). Every program is static: the git image has no
# C library. A shell, against containers/AGENTS.md's rule:
# it is the image's purpose (containers/flux-toolbox/REFERENCES.md).
#
# Runtime contract: UID/GID 65532 (nonroot, HOME /tmp: busybox's passwd).
# /git, the working directory, writable by it (the git image's). `sh` by
# default; a command as arguments (`docker run <image> flux build ...`).
# Credentials from the runtime: a kubeconfig mounted read-only and named
# by KUBECONFIG, or in a pod its service account; git's as the git
# image's header says; sops' keys too (SOPS_AGE_KEY, SOPS_AGE_KEY_FILE).
# No port. With --read-only, mount a tmpfs on /tmp (HOME: kubectl's,
# helm's and nushell's caches and configuration). Runs with no capability
# and no-new-privileges. flux's plugins are in /usr/libexec/flux/plugins,
# named by FLUXCD_PLUGINS (flux's default, ~/.fluxcd/plugins, is under
# HOME): `flux schema ...`. Point FLUXCD_PLUGINS at a writable folder for
# `flux plugin install`. Nushell's plugins are in /usr/bin, not
# registered: `plugin add nu_plugin_<name>` (nushell finds them next to
# nu), or `nu --plugins '[/usr/bin/nu_plugin_<name>]'`. `sops --version`
# asks GitHub for the latest release unless given
# --disable-version-check (or SOPS_DISABLE_VERSION_CHECK=true).

# Versions come from containers/flux-toolbox/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md); git's, kubectl's and helm's
# are these FROM lines, their images' tags (helm's: the kustomize image's
# Helm, its HELM_VERSION). Go's too: the golang tag and digest of
# containers/kustomize, so that Renovate moves both together.
FROM ghcr.io/spnngl/images/git:2.56.1@sha256:2ae09cc91b8f61e7ea36c372b84927ce5416e52c522b62d4243df747c0892da8 AS base
FROM ghcr.io/spnngl/images/kubectl:1.37.2@sha256:1658d36cdb5db1621b91ec32175d4d84b71759ff461bd9b777352ca3b03951f8 AS kubectl
FROM ghcr.io/spnngl/images/kustomize:5.8.3@sha256:8ceb710ec9636feeabea7987adfb16ff4bc8750d7088b1545e6e86e43929249a AS helm

# sops, as tagged (its Go modules too, no update), built with this Go
# rather than taken from its release, whose binary ships the Go it was
# released with: a fixed vulnerability of the standard library stays in
# it until sops' next release. Built as upstream's release
# (.goreleaser.yaml, binary-linux): CGO_ENABLED=0, -trimpath,
# -mod=readonly, the version by -X. Tested in the build stage below,
# with the others. age-keygen too, for that test alone (sops makes no age
# key): from sops' own module graph, the age it vendors; not shipped.
FROM docker.io/library/golang:1.27-trixie@sha256:c47c3fda018d13d43a6bf5ebac3e5bba8a23a35782aa4faf531afaf47c64c39f AS sops

ARG SOPS_VERSION
ARG SOPS_CHECKSUM
# HOME for the build user below (no passwd entry): go reads it, and
# root's (/root) is closed to it. Before SHELL: hadolint (2.15.1) checks
# the RUNs after an ENV or ARG as /bin/sh, whatever SHELL says.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# Checks first: outside Bake, the build fails here.
RUN : "${SOPS_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"

# --checksum: the tag must resolve to its commit, tags can be moved. No
# .git: the release build reads none, the version is set below.
ADD --link \
    --checksum=${SOPS_CHECKSUM} \
    https://github.com/getsops/sops.git#v${SOPS_VERSION} /src

# Build as the image's user, not root, the sources staying root's.
# WORKDIR creates its folder owned by USER: /out takes the binaries.
# Caches: containers/minio's ids, the same user.
USER 65532:65532
WORKDIR /out
WORKDIR /src
RUN --mount=type=cache,id=go-mod-65532,uid=65532,gid=65532,target=/go/pkg/mod \
    --mount=type=cache,id=go-build-65532,uid=65532,gid=65532,target=/tmp/.cache/go-build \
    <<EORUN
CGO_ENABLED=0 go build -trimpath -mod=readonly -o /out/sops -ldflags \
    "-s -w -X github.com/getsops/sops/v3/version.Version=${SOPS_VERSION}" \
    ./cmd/sops
CGO_ENABLED=0 go build -trimpath -mod=readonly -o /out/age-keygen \
    filippo.io/age/cmd/age-keygen
go version -m /out/sops | grep -E '^\s+build\s+CGO_ENABLED=0$'
go version -m /out/age-keygen | grep -E '^\s+build\s+CGO_ENABLED=0$'
EORUN

# The build stage is the base itself: busybox has what checking and
# unpacking need (sha256sum, tar, gzip), and the binaries are tested on
# the libc-less system they ship on.
FROM base AS build

ARG TARGETARCH
ARG BASE_VERSION
ARG BASE_CHECKSUM
ARG FLUX_OPERATOR_VERSION
ARG FLUX_OPERATOR_CHECKSUM
ARG FLUX_SCHEMA_VERSION
ARG FLUX_SCHEMA_CHECKSUM
ARG KUSTOMIZE_VERSION
ARG KUSTOMIZE_CHECKSUM
ARG NUSHELL_VERSION
ARG NUSHELL_CHECKSUM
ARG SOPS_VERSION
# nushell names its builds by Rust target (x86_64, aarch64), the others
# by Go's GOARCH, as TARGETARCH (amd64, arm64).
ARG NUSHELL_ARCH_AMD64=${TARGETARCH/amd64/x86_64}
ARG NUSHELL_ARCH=${NUSHELL_ARCH_AMD64/arm64/aarch64}
# busybox's shell, ash: POSIX, with pipefail. By its name, so that
# hadolint knows it has pipefail (DL4006).
SHELL ["/bin/ash", "-xeuo", "pipefail", "-c"]

# Checks first: outside Bake, the build fails here.
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
: "${FLUX_OPERATOR_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
: "${FLUX_SCHEMA_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
: "${KUSTOMIZE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
: "${NUSHELL_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
: "${SOPS_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
EORUN

# Each release's checksum file, pinned by --checksum (a release whose
# assets change fails the build), then this platform's archive, checked
# against it below. Owned by the build's user, 65532: a remote ADD
# writes 0600 (--chmod would also apply to the folders it creates,
# leaving them untraversable). Licenses: flux's and kustomize's archives
# have none, so each from its tag (text, not pinned).
ADD --link --chown=65532:65532 \
    --checksum=sha256:${BASE_CHECKSUM} \
    https://github.com/fluxcd/flux2/releases/download/v${BASE_VERSION}/flux_${BASE_VERSION}_checksums.txt /dl/flux/
ADD --link --chown=65532:65532 \
    https://github.com/fluxcd/flux2/releases/download/v${BASE_VERSION}/flux_${BASE_VERSION}_linux_${TARGETARCH}.tar.gz /dl/flux/
ADD --link --chown=65532:65532 \
    https://raw.githubusercontent.com/fluxcd/flux2/v${BASE_VERSION}/LICENSE /dl/flux/
ADD --link --chown=65532:65532 \
    --checksum=sha256:${FLUX_OPERATOR_CHECKSUM} \
    https://github.com/controlplaneio-fluxcd/flux-operator/releases/download/v${FLUX_OPERATOR_VERSION}/flux-operator_${FLUX_OPERATOR_VERSION}_checksums.txt /dl/flux-operator/
ADD --link --chown=65532:65532 \
    https://github.com/controlplaneio-fluxcd/flux-operator/releases/download/v${FLUX_OPERATOR_VERSION}/flux-operator_${FLUX_OPERATOR_VERSION}_linux_${TARGETARCH}.tar.gz /dl/flux-operator/
ADD --link --chown=65532:65532 \
    --checksum=sha256:${FLUX_SCHEMA_CHECKSUM} \
    https://github.com/fluxcd/flux-schema/releases/download/v${FLUX_SCHEMA_VERSION}/flux-schema_${FLUX_SCHEMA_VERSION}_checksums.txt /dl/flux-schema/
ADD --link --chown=65532:65532 \
    https://github.com/fluxcd/flux-schema/releases/download/v${FLUX_SCHEMA_VERSION}/flux-schema_${FLUX_SCHEMA_VERSION}_linux_${TARGETARCH}.tar.gz /dl/flux-schema/
ADD --link --chown=65532:65532 \
    --checksum=sha256:${KUSTOMIZE_CHECKSUM} \
    https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv${KUSTOMIZE_VERSION}/checksums.txt /dl/kustomize/
ADD --link --chown=65532:65532 \
    https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv${KUSTOMIZE_VERSION}/kustomize_v${KUSTOMIZE_VERSION}_linux_${TARGETARCH}.tar.gz /dl/kustomize/
ADD --link --chown=65532:65532 \
    https://raw.githubusercontent.com/kubernetes-sigs/kustomize/kustomize/v${KUSTOMIZE_VERSION}/LICENSE /dl/kustomize/
ADD --link --chown=65532:65532 \
    --checksum=sha256:${NUSHELL_CHECKSUM} \
    https://github.com/nushell/nushell/releases/download/${NUSHELL_VERSION}/SHA256SUMS /dl/nushell/
ADD --link --chown=65532:65532 \
    https://github.com/nushell/nushell/releases/download/${NUSHELL_VERSION}/nu-${NUSHELL_VERSION}-${NUSHELL_ARCH}-unknown-linux-musl.tar.gz /dl/nushell/

# Unpack as the image's user, not root. WORKDIR creates its folder owned
# by USER: /out takes the image's files.
USER 65532:65532
WORKDIR /out
WORKDIR /tmp/unpack

# Each archive checked against its release's checksum file: its line,
# by file name (sha256sum -c of no line passes). Each archive unpacked
# into its tool's folder: flux-operator's and flux-schema's both hold a
# LICENSE. Then the programs into /usr/bin, flux's plugins into
# /usr/libexec/flux/plugins (FLUXCD_PLUGINS, below), the licenses into
# /usr/share/doc/<name>/. Nushell's plugins but the examples and test
# fixtures (example, custom_values, stress_internals).
RUN <<EORUN
verify() {
    sum="$(awk -v f="$3" '$2 == f || $2 == "*" f { print $1 }' "/dl/$1/$2")"
    [ -n "${sum}" ]
    echo "${sum}  /dl/$1/$3" | sha256sum -c -
}
verify flux "flux_${BASE_VERSION}_checksums.txt" "flux_${BASE_VERSION}_linux_${TARGETARCH}.tar.gz"
verify flux-operator "flux-operator_${FLUX_OPERATOR_VERSION}_checksums.txt" "flux-operator_${FLUX_OPERATOR_VERSION}_linux_${TARGETARCH}.tar.gz"
verify flux-schema "flux-schema_${FLUX_SCHEMA_VERSION}_checksums.txt" "flux-schema_${FLUX_SCHEMA_VERSION}_linux_${TARGETARCH}.tar.gz"
verify kustomize checksums.txt "kustomize_v${KUSTOMIZE_VERSION}_linux_${TARGETARCH}.tar.gz"
nushell="nu-${NUSHELL_VERSION}-${NUSHELL_ARCH}-unknown-linux-musl"
verify nushell SHA256SUMS "${nushell}.tar.gz"
for d in flux flux-operator flux-schema kustomize nushell; do
    mkdir "${d}"
    tar -xzf "/dl/${d}/"*.tar.gz -C "${d}"
done
mkdir -p /out/usr/bin /out/usr/libexec/flux/plugins /out/usr/share/doc/flux \
    /out/usr/share/doc/flux-operator /out/usr/share/doc/flux-schema \
    /out/usr/share/doc/kustomize /out/usr/share/doc/nushell
cp flux/flux flux-operator/flux-operator kustomize/kustomize "nushell/${nushell}/nu" \
    "nushell/${nushell}/nu_plugin_formats" "nushell/${nushell}/nu_plugin_gstat" \
    "nushell/${nushell}/nu_plugin_inc" "nushell/${nushell}/nu_plugin_polars" \
    "nushell/${nushell}/nu_plugin_query" /out/usr/bin/
cp flux-schema/flux-schema /out/usr/libexec/flux/plugins/
cp /dl/flux/LICENSE /out/usr/share/doc/flux/
cp flux-operator/LICENSE /out/usr/share/doc/flux-operator/
cp flux-schema/LICENSE /out/usr/share/doc/flux-schema/
cp /dl/kustomize/LICENSE /out/usr/share/doc/kustomize/
cp "nushell/${nushell}/LICENSE" /out/usr/share/doc/nushell/
# A remote ADD writes 0600: readable by every user in the image.
chmod 644 /out/usr/share/doc/*/LICENSE
rm -r /tmp/unpack
EORUN

# kubectl, its license and those of its vendored code: tested below with
# the others.
COPY --link --from=kubectl /usr/bin/kubectl /out/usr/bin/
COPY --link --from=kubectl /usr/share/doc/kubectl/ /out/usr/share/doc/kubectl/
# helm and its license, from the kustomize image (built there from its
# tag, static): tested below with the others.
COPY --link --from=helm /usr/bin/helm /out/usr/bin/
COPY --link --from=helm /usr/share/doc/helm/ /out/usr/share/doc/helm/
# sops and its license, built above. age-keygen outside /out, the smoke
# test's alone; not in /tmp, which a --link COPY would recreate root's,
# 0755.
COPY --link --from=sops /out/sops /out/usr/bin/
COPY --link --from=sops /src/LICENSE /out/usr/share/doc/sops/
COPY --link --from=sops /out/age-keygen /usr/local/bin/

# Smoke test, offline, with the image's binaries first in PATH. Every
# version is the pinned one, every program runs here (no C library: a
# dynamic one fails), and each does something real: manifests generated
# client-side (flux, flux-operator, kubectl), a schema extracted from a
# CRD and manifests validated against it (flux-schema, run as flux's
# plugin), a chart rendered (helm), a file encrypted and decrypted
# (sops), a kustomization built and compared byte for byte, each nushell
# plugin loaded at nu's version and used. helm's version is the kustomize
# image's: its major checked, Helm 4. Automerged updates rely on it.
WORKDIR /tmp/smoke
RUN <<EORUN
export PATH="/out/usr/bin:${PATH}" FLUXCD_PLUGINS=/out/usr/libexec/flux/plugins
git --version
flux version --client | grep -Fx "flux: v${BASE_VERSION}"
flux schema version | grep -Fx "${FLUX_SCHEMA_VERSION}"
flux-operator version --client | grep -Fx "client: ${FLUX_OPERATOR_VERSION}"
[ "$(kustomize version)" = "v${KUSTOMIZE_VERSION}" ]
nu --version | grep -Fx "${NUSHELL_VERSION}"
kubectl version --client
helm version --template '{{ .Version }}' | grep -Ex 'v4\.[0-9]+\.[0-9]+'
sops --version --disable-version-check | grep -Fx "sops ${SOPS_VERSION}"

flux create source git smoke --url=https://example.com/smoke.git --branch=main --export > flux.yaml
grep -Fx 'kind: GitRepository' flux.yaml
grep -Fx '  url: https://example.com/smoke.git' flux.yaml

cat > resourceset.yaml <<EOF
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: smoke
  namespace: default
spec:
  inputs:
    - tenant: smoke-tenant
  resources:
    - apiVersion: v1
      kind: Namespace
      metadata:
        name: << inputs.tenant >>
EOF
flux-operator build resourceset -f resourceset.yaml > namespace.yaml
grep -Fx 'kind: Namespace' namespace.yaml
grep -Fx '  name: smoke-tenant' namespace.yaml

cat > crd.yaml <<EOF
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: smokes.example.com
spec:
  group: example.com
  names:
    kind: Smoke
    plural: smokes
  scope: Namespaced
  versions:
    - name: v1
      served: true
      storage: true
      schema:
        openAPIV3Schema:
          type: object
          properties:
            spec:
              type: object
              properties:
                replicas:
                  type: integer
EOF
flux schema extract crd -d schemas crd.yaml
printf 'apiVersion: example.com/v1\nkind: Smoke\nmetadata:\n  name: good\nspec:\n  replicas: 1\n' > good.yaml
printf 'apiVersion: example.com/v1\nkind: Smoke\nmetadata:\n  name: bad\nspec:\n  replicas: one\n' > bad.yaml
flux schema validate good.yaml --schema-location ./schemas
if flux schema validate bad.yaml --schema-location ./schemas; then
    exit 1
fi

mkdir -p chart/templates
printf 'apiVersion: v2\nname: smoke\nversion: 0.1.0\n' > chart/Chart.yaml
printf 'apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: {{ .Release.Name }}\ndata:\n  key: {{ .Values.key }}\n' > chart/templates/configmap.yaml
helm template app ./chart --set key=value > helm.yaml
grep -Fx '  name: app' helm.yaml
grep -Fx '  key: value' helm.yaml

# A fresh age key pair, made here and gone with this stage.
age-keygen -o age.txt
printf 'key: value\n' > secret.yaml
sops --encrypt --age "$(age-keygen -y age.txt)" secret.yaml > secret.enc.yaml
if grep -Fx 'key: value' secret.enc.yaml; then
    exit 1
fi
SOPS_AGE_KEY_FILE=age.txt sops --decrypt secret.enc.yaml | cmp - secret.yaml

kubectl create configmap smoke --from-literal=key=value --dry-run=client --output=yaml > configmap.yaml
printf 'resources:\n- configmap.yaml\nnamePrefix: app-\n' > kustomization.yaml
printf 'apiVersion: v1\ndata:\n  key: value\nkind: ConfigMap\nmetadata:\n  name: app-smoke\n' > expected.yaml
kustomize build . | cmp - expected.yaml

git init -q -b main repo
touch repo/file
git -C repo add file
plugins=""
for p in formats gstat inc polars query; do
    plugins="${plugins} /out/usr/bin/nu_plugin_${p}"
done
nu --no-config-file --plugins "[${plugins}]" --commands '
use std/assert
assert equal (plugin list | where version == (version).version | get name | sort) [formats gstat inc polars query]
assert equal ("[s]\na=1" | from ini | get s.a) "1"
assert equal (gstat repo | get idx_added_staged) 1
assert equal ("1.2.3" | inc --minor) "1.3.0"
assert equal ([[a]; [1] [2]] | polars into-df | polars sum | polars into-nu | get a.0) 3
assert equal ("{\"a\": 1}" | query json a) 1
'
rm -r /tmp/smoke
EORUN

FROM base
ARG BASE_VERSION

# The licenses of git, OpenSSH and busybox come with the base image.
# source: links the ghcr.io package to this repository.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="Apache-2.0 AND AGPL-3.0-only AND MIT AND MPL-2.0 AND GPL-2.0-only AND SSH-OpenSSH" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

# The programs and licenses: root's, not the build user's, so that the
# user can't replace them.
COPY --link --from=build --chown=0:0 /out/ /

# flux finds its plugins here, not under HOME (~/.fluxcd/plugins): HOME
# is /tmp, a tmpfs or empty at runtime.
ENV FLUXCD_PLUGINS=/usr/libexec/flux/plugins

# Numeric, so runAsNonRoot can check it (the git image's already).
USER 65532:65532

# A shell, as busybox's image: the git image's entrypoint (git) reset.
ENTRYPOINT []
CMD ["/bin/sh"]
