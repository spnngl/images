# syntax=docker.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#
# ignition-converter (mutating admission webhook rewriting the Ignition
# spec 2.x user data of Cluster API bootstrap Secrets to spec 3.0, Go)
# built from source as tagged, no patch, one static binary on scratch.
# Upstream (spnngl/ignition-converter) publishes binaries, no image: this
# is the one its README and deploy.yaml name.
#
# Runtime contract: UID/GID 65532 (no passwd entry); HTTPS on 8443/tcp
# (--addr), POST /mutate (AdmissionReview v1) and GET /healthz;
# --cert-file and --key-file required, no default: the serving
# certificate and key, mounted read-only (deploy.yaml: /tls, from
# cert-manager's Secret), reread at each handshake. No volume and no
# outbound connection: it writes nothing and never calls the Kubernetes
# API. Runs with a read-only root filesystem, no capability and
# no-new-privileges.

# Versions come from containers/ignition-converter/docker-bake.hcl: build
# with `docker buildx bake` (containers/AGENTS.md).
# Debian trixie: its openssl makes the server test's certificate.
FROM docker.io/library/golang:1.27-trixie@sha256:af1bfc2614ebb1dbd31af514b78740fd678850e76498762b425ecee4c5c6ea80 AS build

ARG BASE_VERSION
ARG BASE_CHECKSUM
ARG DEBIAN_CODENAME
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
# HOME for the build user below (no passwd entry): go reads it, and
# root's (/root) is closed to it. Before SHELL: hadolint (2.15.1) checks
# the RUNs after an ENV or ARG as /bin/sh, whatever SHELL says.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]
WORKDIR /src

# Checks first: outside Bake, or on another Debian release than the tag
# names, the build fails here.
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
EORUN

# --checksum: the tag must resolve to this commit, tags can be moved.
# No .git: -X main.version below sets the version.
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/spnngl/ignition-converter.git#v${BASE_VERSION} /src

# Build and test as the image's user, not root: the webhook doesn't get
# root, and the source stays root's. WORKDIR creates its folder owned by
# USER: /out takes the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /src

# Upstream's release build (Makefile's dist target: CGO_ENABLED=0,
# -trimpath, -s -w), with the version its --version prints
# (cmd/ignition-converter/main.go).
# Caches: containers/minio's ids, the same user.
RUN --mount=type=cache,id=go-mod-65532,uid=65532,gid=65532,target=/go/pkg/mod \
    --mount=type=cache,id=go-build-65532,uid=65532,gid=65532,target=/tmp/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${BASE_VERSION}" \
    -o /out/ignition-converter ./cmd/ignition-converter

# Server smoke test, here because scratch has no shell to run it, and
# because webhook releases and golang bumps are automerged on it. A
# throwaway certificate for 127.0.0.1, trusted by curl: /healthz, then
# two AdmissionReviews of a bootstrap Secret. Upstream's fixture (Cluster
# API's own rendering of a kubeadm join): its JSON patch must set
# Ignition spec 3.0.0. No jq in the image: sed takes the two base64
# layers apart (the patch, then its value). Data that isn't Ignition:
# denied, the webhook fails closed. Then a clean stop: SIGTERM exits 0.
# kill (DL3001) stops the webhook this step started, not a container's.
# hadolint ignore=DL3001
RUN <<EORUN
/out/ignition-converter --version | grep -Fx "ignition-converter ${BASE_VERSION}"
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 1 \
    -subj /CN=127.0.0.1 -addext subjectAltName=IP:127.0.0.1 \
    -keyout /tmp/tls.key -out /tmp/tls.crt
/out/ignition-converter --addr 127.0.0.1:8443 --cert-file /tmp/tls.crt --key-file /tmp/tls.key &
webhook=$!
https=(curl -fsS --cacert /tmp/tls.crt)
"${https[@]}" --retry 30 --retry-delay 1 --retry-connrefused https://127.0.0.1:8443/healthz | grep -Fx ok
# review <user data, base64>: the answer to a bootstrap Secret's review.
review() {
    printf '{"apiVersion":"admission.k8s.io/v1","kind":"AdmissionReview","request":{"uid":"smoke-test","operation":"CREATE","namespace":"default","name":"smoke-test","object":{"apiVersion":"v1","kind":"Secret","type":"cluster.x-k8s.io/secret","data":{"format":"%s","value":"%s"}}}}' \
        "$(printf ignition | base64 -w0)" "$1" |
        "${https[@]}" -H 'Content-Type: application/json' --data-binary @- https://127.0.0.1:8443/mutate
}
review "$(base64 -w0 cmd/ignition-converter/testdata/kubeadm-join.json)" > /tmp/response.json
grep -qF '"uid":"smoke-test","allowed":true' /tmp/response.json
sed -n 's/.*"patch":"\([^"]*\)".*/\1/p' /tmp/response.json | base64 -d |
    sed -n 's/.*"path":"\/data\/value","value":"\([^"]*\)".*/\1/p' | base64 -d |
    grep -F '"ignition":{"version":"3.0.0"'
review "$(printf 'not json' | base64 -w0)" | grep -F '"uid":"smoke-test","allowed":false'
kill "${webhook}"
wait "${webhook}"
rm /tmp/tls.crt /tmp/tls.key /tmp/response.json
EORUN

# The webhook execs nothing, has no C library and makes no outbound
# connection: the binary and the license (Apache-2.0: its text ships with
# the binary; upstream has no NOTICE). No CA bundle.
FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="Apache-2.0" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

COPY --link --from=build /src/LICENSE /usr/share/doc/ignition-converter/
# Owned by root, not by the build's user: the webhook can't rewrite its
# binary.
COPY --link --from=build --chown=0:0 /out/ignition-converter /usr/bin/

# Numeric, so runAsNonRoot can check it. No privilege needed: the port is
# above 1024.
USER 65532:65532

EXPOSE 8443/tcp

# No CMD: the certificate paths have no default upstream, and deploy.yaml
# passes every flag.
ENTRYPOINT ["/usr/bin/ignition-converter"]

# Smoke test: the binary runs on this platform (the build stage tested the
# server).
RUN ["/usr/bin/ignition-converter", "--version"]
