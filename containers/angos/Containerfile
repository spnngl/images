# syntax=docker.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#
# Angos (https://github.com/project-angos/angos), an OCI registry with no
# database, its state in a directory or an S3 bucket: one static musl
# binary on scratch, its web UI embedded. Upstream's
# ghcr.io/project-angos/angos paths (/angos), but UID 65532, not 65534,
# and with a default command.
#
# Runtime contract: UID/GID 65532 (no passwd entry). The configuration,
# none shipped: /config/config.toml (CMD), more files merged with more
# `-c` (credentials apart, upstream's Kubernetes guide); mounted as a
# directory, not a single file, so its changes reload without a restart.
# State: the store, an S3 bucket or [blob_store.fs] root_dir, /data
# writable by 65532 (a new named volume takes its owner, a bind mount
# needs a chown). HTTP on 8000/tcp ([server] port), with /healthz,
# /readyz and /metrics, each open only if an access policy rule allows
# its action (upstream's set-up-access-control how-to). `scanner` mode on
# 8766/tcp, with trivy or grype mounted from its image and on PATH
# (upstream's scan-images how-to); `worker`, `scrub` and `prune` from
# the same image, replacing CMD.
# RUST_LOG sets the log level, errors only when unset. Runs with a
# read-only root filesystem, no capability and no-new-privileges.
# https://github.com/project-angos/angos/tree/main/doc/how-to

# Versions come from containers/angos/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md).

# --checksum: the tag must resolve to this commit, tags can be moved. No
# .git: Cargo.toml sets the version.
FROM scratch AS source
ARG BASE_VERSION
ARG BASE_CHECKSUM
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/project-angos/angos.git#v${BASE_VERSION} /

# Node for the web UI, which the crate's build.rs builds with npm:
# upstream's major (its Dockerfile, .github/workflows/build.yaml).
FROM docker.io/library/node:24.22-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS node

# Debian trixie: its musl-tools build the C libraries, its ca-certificates
# is the CA bundle copied below.
FROM docker.io/library/rust:1.99-trixie@sha256:931c2c0531a8b143e044f0f3914dfe802f15bb3d1955f0b657e9359327ac2ffc AS build

ARG BASE_VERSION
ARG DEBIAN_CODENAME
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NOWARNINGS="yes"
ARG DEBIAN_SNAPSHOT_VERSION
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
# HOME for the build user below (no passwd entry): npm keeps its cache
# there.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# node's binary links glibc and libstdc++, both in rust's image.
COPY --link --from=node /usr/local/bin/node /usr/local/bin/
COPY --link --from=node /usr/local/lib/node_modules/npm/ /usr/local/lib/node_modules/npm/

# musl-tools: musl-gcc, for the C code of the crates (aws-lc, ring, zstd).
# cargo-auditable: embeds the dependency list in the binary, for the SBOM
# and the vulnerability scans. argon2: hashes the server test's password
# (`angos argon` reads it from a terminal). ca-certificates: copied into
# the image below.
# Not pinned (DL3008): versions follow the snapshot, which Renovate moves.
# rustup's musl target and the npm link are installed here too, while
# root.
# Checks first: outside Bake, or on another Debian release than the build
# args name, the build fails here.
# Snapshot: see containers/AGENTS.md. No Valid-Until: snapshot Release
# files expire.
# hadolint ignore=DL3008
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
sed -i -E "s#^URIs: http://deb\.debian\.org/(debian(-security)?)\$#URIs: http://snapshot.debian.org/archive/\1/${DEBIAN_SNAPSHOT_VERSION:?build with docker buildx bake, see containers/AGENTS.md}/#" /etc/apt/sources.list.d/debian.sources
echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
apt-get update
apt-get install -y --no-install-recommends argon2 ca-certificates cargo-auditable musl-tools
rm -rf /var/lib/apt/lists/*
rustup target add "$(uname -m)-unknown-linux-musl"
ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
EORUN

# Built and tested as the image's user, in its own copy (build.rs writes
# ui/node_modules and ui/build): neither the packages' install scripts,
# the crates' build scripts nor the server get root. No passwd entry
# needed: CARGO_HOME and RUSTUP_HOME are set, /usr/local/cargo is
# writable by all. WORKDIR creates its folder owned by USER: /out takes
# the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /build
COPY --link --from=source --chown=65532:65532 / /build/

# The UI's packages first, from package-lock.json (npm ci): build.rs runs
# `npm install` only without ui/node_modules, then `npm run build` into
# ui/build, which the release binary embeds (rust-embed). Then upstream's
# release build (cargo build --release), static: the rustup musl targets
# link statically by default. Not upstream's rust-lld RUSTFLAGS: they
# serve its cross builds, and cargo auditable passes the linker gcc's
# -Wl, flags. CC_<target>: cc-rs builds the C code with musl-gcc, not
# glibc's gcc. The version is Cargo.toml's (CARGO_PKG_VERSION).
# Caches: uid sets the owner of a new cache only, and one is shared by
# every build that uses its id (the target by default): ids of their own,
# as containers/garage does.
RUN --mount=type=cache,id=npm-cache-65532,uid=65532,gid=65532,target=/tmp/.npm \
    --mount=type=cache,id=cargo-registry-65532,uid=65532,gid=65532,target=/usr/local/cargo/registry \
    --mount=type=cache,id=angos-target-65532,uid=65532,gid=65532,target=/build/target \
    <<EORUN
npm ci --prefix ui
target="$(uname -m)-unknown-linux-musl"
export "CC_${target//-/_}=musl-gcc"
cargo auditable build --locked --release --target "${target}"
cp "target/${target}/release/angos" /out/
if readelf -dW /out/angos | grep -qF NEEDED; then exit 1; fi
EORUN

# Server smoke test, here because scratch has no shell to run it:
# smoke-test.toml (next to this file) merged with a second file holding
# a random throwaway user, as upstream's guides keep credentials apart
# (smoke-test.toml opens the probes, the metrics and the UI to anonymous
# requests). The version, with no --version: the root package of the
# list cargo auditable embeds (zlib JSON in .dep-v0). Not the version
# strings: the compiler may turn them into instructions (amd64 does).
# Anonymous registry requests refused, the embedded UI served, then a
# 1 MiB blob and a manifest pushed and pulled back through the OCI API,
# the pushes (201) counted in the metrics, and a graceful stop.
# kill (DL3001) stops the server this step started, not a container's.
# hadolint ignore=DL3001
RUN --mount=type=bind,source=smoke-test.toml,target=/etc/angos/smoke-test.toml \
    <<EORUN
version="$(objcopy --dump-section .dep-v0=/dev/stdout /out/angos /dev/null \
    | python3 -c 'import json, sys, zlib; print(*(p["name"] + " " + p["version"] for p in json.loads(zlib.decompress(sys.stdin.buffer.read()))["packages"] if p.get("root")))')"
[ "${version}" = "angos ${BASE_VERSION}" ]
hex() { od -An -vtx1 -N16 /dev/urandom | tr -d ' \n'; }
password="$(hex)"
hash="$(printf '%s' "${password}" | argon2 "$(hex)" -id -t 2 -k 19456 -p 1 -e)"
printf '[auth.identity.smoke]\nusername = "smoke"\npassword = "%s"\n' "${hash}" > /tmp/auth.toml
/out/angos -c /etc/angos/smoke-test.toml -c /tmp/auth.toml server &
server=$!
base=http://127.0.0.1:8000
curl -fsS --retry 30 --retry-delay 1 --retry-connrefused "${base}/healthz"
curl -fsS --retry 30 --retry-delay 1 --retry-all-errors "${base}/readyz"
curl -fsS "${base}/" | grep -qF theme-preference
[ "$(curl -sS -o /dev/null -w '%{http_code}' "${base}/v2/")" = 401 ]
oci=(curl -fsS --user "smoke:${password}")
repo="${base}/v2/smoke-test"
push_blob() {
    local location
    location="$("${oci[@]}" -X POST -D - -o /dev/null "${repo}/blobs/uploads/" | sed -nE 's/^location: *(\/[^[:space:]]+).*$/\1/Ip')"
    "${oci[@]}" -X PUT -H 'Content-Type: application/octet-stream' --data-binary "@$1" \
        "${base}${location}?digest=sha256:$(sha256sum "$1" | cut -d' ' -f1)"
}
head -c 1M /dev/urandom > /tmp/layer
printf '{}' > /tmp/config
push_blob /tmp/layer
push_blob /tmp/config
cat > /tmp/manifest <<EOF
{"schemaVersion":2,"mediaType":"application/vnd.oci.image.manifest.v1+json","artifactType":"application/vnd.angos.smoke-test","config":{"mediaType":"application/vnd.oci.empty.v1+json","digest":"sha256:$(sha256sum /tmp/config | cut -d' ' -f1)","size":2},"layers":[{"mediaType":"application/octet-stream","digest":"sha256:$(sha256sum /tmp/layer | cut -d' ' -f1)","size":1048576}]}
EOF
"${oci[@]}" -X PUT -H 'Content-Type: application/vnd.oci.image.manifest.v1+json' --data-binary @/tmp/manifest "${repo}/manifests/smoke"
"${oci[@]}" "${repo}/tags/list" | grep -qF '"smoke"'
"${oci[@]}" -H 'Accept: application/vnd.oci.image.manifest.v1+json' "${repo}/manifests/smoke" | cmp - /tmp/manifest
"${oci[@]}" -L "${repo}/blobs/sha256:$(sha256sum /tmp/layer | cut -d' ' -f1)" | cmp - /tmp/layer
curl -fsS "${base}/metrics" | grep -qE '^http_requests_total\{.*status="201".*\} [1-9]'
kill "${server}"
wait "${server}"
rm -r /tmp/angos /tmp/auth.toml /tmp/layer /tmp/config /tmp/manifest
EORUN

RUN mkdir /out/data

# The image's files, and the UI's packages for the image's SBOM only: the
# binary embeds the UI's bundle, where no scanner reads them. Every
# package, build tools included: the bundle holds some of them (svelte,
# @sveltejs/kit). A stage of its own: in the build stage, the SBOM would
# add rust's and node's images.
# The image copies from here, to depend on this stage: BuildKit scans
# only the stages the target depends on.
FROM scratch AS angos-files
ARG BUILDKIT_SBOM_SCAN_STAGE=true
COPY --link --from=build /build/ui/node_modules/ /node_modules/
# Upstream image's binary path, so its docs apply as is. root's, not the
# build user's: the server can't replace its own binary.
COPY --link --from=build --chown=0:0 /out/angos /angos
# CA bundle: TLS to S3, upstream registries, OIDC issuers and webhooks
# (rustls reads this path); refreshed by the weekly rebuild.
COPY --link --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --link --from=build --chown=0:0 /build/LICENSE /usr/share/doc/angos/

FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="Apache-2.0" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

COPY --link --from=angos-files /angos /angos
COPY --link --from=angos-files /etc/ssl/certs/ /etc/ssl/certs/
COPY --link --from=angos-files /usr/share/doc/angos/ /usr/share/doc/angos/
# State directory, owned by the image's user: a named volume mounted
# there starts with that owner, so it is writable without a chown. The
# source folder itself, not its contents: COPY creates a destination
# folder as root.
COPY --link --from=build --chown=65532:65532 /out/data /data

# Numeric, so runAsNonRoot can check it. No privilege needed: every port
# is above 1024.
USER 65532:65532

# The registry, the scanner service: upstream's defaults. Documentation
# only.
EXPOSE 8000/tcp 8766/tcp

# Arguments are Angos': upstream's guides pass
# `-c /config/config.toml server`, which a Kubernetes `args:` or a
# compose `command:` copied from them replaces as is.
ENTRYPOINT ["/angos"]
CMD ["-c", "/config/config.toml", "server"]

# Smoke test: the binary is static and runs on this platform (the build
# stage tested the server).
RUN ["/angos", "--help"]
