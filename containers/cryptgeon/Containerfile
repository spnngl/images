# syntax=docker.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#
# Cryptgeon (https://github.com/cupcakearmy/cryptgeon), encrypted notes
# and files that self-destruct after their views or their expiration:
# the server, one static musl binary, and its web frontend on scratch.
# Upstream's cupcakearmy/cryptgeon paths (/app/cryptgeon, /app/frontend),
# but not root, and its Redis client built without TLS (plain redis://
# only, containers/cryptgeon/REFERENCES.md).
#
# Runtime contract: UID/GID 65532 (no passwd entry). Stateless: notes
# live in Redis (or Valkey), at REDIS (default redis://redis/, upstream's),
# run in memory only as upstream's compose file does (--save ""
# --appendonly no). HTTP on 8000/tcp (LISTEN_ADDR); settings are
# upstream's environment variables (SIZE_LIMIT, MAX_VIEWS...). Runs with
# a read-only root filesystem, no capability and no-new-privileges: it
# writes nothing. Redis is plain TCP, a password in REDIS included: keep
# it on a private network (a NetworkPolicy between the two). Stops on
# SIGKILL (STOPSIGNAL below).
# https://github.com/cupcakearmy/cryptgeon#environment-variables

# Versions come from containers/cryptgeon/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md).

# --checksum: the tag must resolve to this commit, tags can be moved. No
# .git: Cargo.toml and package.json set the version. One stage, read by
# the two builds below.
FROM scratch AS source
ARG BASE_VERSION
ARG BASE_CHECKSUM
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/cupcakearmy/cryptgeon.git#v${BASE_VERSION} /

# The web frontend: static files the server serves. Node: upstream's
# major (.nvmrc); pnpm: upstream's (package.json's packageManager), which
# corepack downloads and verifies.
FROM docker.io/library/node:24.22-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS frontend

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# HOME for the build user below (no passwd entry): corepack and pnpm keep
# their caches there. Before SHELL: hadolint (2.15.1) checks the RUNs
# after an ENV or ARG as /bin/sh, whatever SHELL says.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# The pnpm shim goes in /usr/local/bin: root's.
RUN corepack enable pnpm

# Built as the image's user, in its own copy: neither the packages'
# install scripts nor the build get root.
USER 65532:65532
WORKDIR /build
COPY --link --from=source --chown=65532:65532 / /build/

# Upstream's release build (its Dockerfile): every package but the
# backend, the frontend and the client library it imports
# (packages/cli). --frozen-lockfile: pnpm-lock.yaml's versions and
# integrity hashes. The store is a cache of its own, as the cargo caches
# below.
RUN --mount=type=cache,id=pnpm-store-65532,uid=65532,gid=65532,target=/tmp/pnpm-store <<EORUN
pnpm install --frozen-lockfile --store-dir /tmp/pnpm-store
pnpm run build
EORUN

# The frontend the image ships, and the packages pnpm installed, for the
# image's SBOM only: they are bundled into its JavaScript, where no
# scanner reads them. Every package, build tools included: the bundle
# holds some of them (svelte, @sveltejs/kit). A stage of its own: in the
# frontend stage, the SBOM would add node's image (its Debian packages,
# npm).
# The image copies its frontend from here: BuildKit scans only the
# stages the target depends on.
FROM scratch AS frontend-files
ARG BUILDKIT_SBOM_SCAN_STAGE=true
COPY --link --from=frontend /build/node_modules/.pnpm/ /node_modules/.pnpm/
COPY --link --from=frontend --chown=0:0 /build/packages/frontend/build/ /app/frontend/

# Debian trixie: its musl-tools build the C libraries, its valkey-server
# runs the server test.
FROM docker.io/library/rust:1.99-trixie@sha256:931c2c0531a8b143e044f0f3914dfe802f15bb3d1955f0b657e9359327ac2ffc AS build

ARG BASE_VERSION
ARG DEBIAN_CODENAME
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NOWARNINGS="yes"
ARG DEBIAN_SNAPSHOT_VERSION
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# musl-tools: musl-gcc, for the C code of the crates (ring, zstd).
# cargo-auditable: embeds the dependency list in the binary, for the SBOM
# and the vulnerability scans. valkey-server (and its valkey-cli): the
# server test, Valkey as upstream's compose file runs.
# Not pinned (DL3008): versions follow the snapshot, which Renovate moves.
# rustup's musl target is installed here too, while root.
# Checks first: outside Bake, or on another Debian release than the build
# args name, the build fails here.
# Snapshot: see containers/AGENTS.md. No Valid-Until: snapshot Release
# files expire.
# hadolint ignore=DL3008
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
sed -i -E "s#^URIs: http://deb\.debian\.org/(debian(-security)?)\$#URIs: http://snapshot.debian.org/archive/\1/${DEBIAN_SNAPSHOT_VERSION:?build with docker buildx bake, see containers/AGENTS.md}/#" /etc/apt/sources.list.d/debian.sources
echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
apt-get update
apt-get install -y --no-install-recommends cargo-auditable musl-tools valkey-server
rm -rf /var/lib/apt/lists/*
rustup target add "$(uname -m)-unknown-linux-musl"
EORUN

# Built and tested as the image's user, in its own copy (the build edits
# Cargo.toml and Cargo.lock): neither the crates' build scripts nor the
# server get root. No passwd entry needed: CARGO_HOME and RUSTUP_HOME are
# set, /usr/local/cargo is writable by all. WORKDIR creates its folder
# owned by USER: /out takes the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /build
COPY --link --from=source --chown=65532:65532 /packages/backend/ /build/

# Redis without TLS: tls-native-tls links OpenSSL, which a static musl
# binary can't. The sed fails the build when upstream changes the line;
# cargo update drops the TLS crates from Cargo.lock, and every crate left
# keeps upstream's version. Then upstream's release build (cargo build
# --release), static: the rustup musl targets link statically by default
# (upstream's Alpine build turns that off to link OpenSSL). CC_<target>:
# cc-rs builds the C code with musl-gcc, not glibc's gcc. The version is
# Cargo.toml's (CARGO_PKG_VERSION).
# Caches: uid sets the owner of a new cache only, and one is shared by
# every build that uses its id (the target by default): ids of their own,
# as containers/garage does.
RUN --mount=type=cache,id=cargo-registry-65532,uid=65532,gid=65532,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cryptgeon-target-65532,uid=65532,gid=65532,target=/build/target \
    <<EORUN
sed -i -E 's/^(redis = \{ version = "[^"]+"), features = \["tls-native-tls"\] \}$/\1 }/' Cargo.toml
grep -qE '^redis = \{ version = "[^"]+" \}$' Cargo.toml
crates() { awk '/^name = /{n=$3} /^version = /{print n, $3}' "$1" | sort; }
crates Cargo.lock > /tmp/crates-upstream
cargo update --workspace
[ -z "$(crates Cargo.lock | comm -13 /tmp/crates-upstream -)" ]
target="$(uname -m)-unknown-linux-musl"
export "CC_${target//-/_}=musl-gcc"
cargo auditable build --locked --release --target "${target}"
cp "target/${target}/release/cryptgeon" /out/
if readelf -dW /out/cryptgeon | grep -qF NEEDED; then exit 1; fi
rm /tmp/crates-upstream
EORUN

# Server smoke test, here because scratch has no shell to run it, and the
# binary has no flag to run without Redis (no --version): Valkey in
# memory, the server with the frontend as the image runs it, then a note
# created, previewed, read (which burns it, views: 1) and gone. /api/live
# checks Redis; /api/status prints the version; / is the frontend's
# index.html.
# kill (DL3001) stops the servers this step started, not a container's.
# The server has no SIGTERM handler: it dies of it (143).
# hadolint ignore=DL3001
RUN --mount=type=bind,from=frontend-files,source=/app/frontend,target=/frontend \
    <<EORUN
valkey-server --bind 127.0.0.1 --port 6379 --save '' --appendonly no --dir /tmp &
valkey=$!
timeout 30 bash -c 'until valkey-cli ping; do sleep 1; done'
REDIS=redis://127.0.0.1/ FRONTEND_PATH=/frontend LISTEN_ADDR=127.0.0.1:8000 /out/cryptgeon &
server=$!
api=http://127.0.0.1:8000/api
curl -fsS --retry 30 --retry-delay 1 --retry-connrefused "${api}/live"
curl -fsS "${api}/status" | grep -F "\"version\":\"${BASE_VERSION}\""
curl -fsS http://127.0.0.1:8000/ | grep -F '<div id="svelte">'
id="$(curl -fsS -H 'Content-Type: application/json' \
    -d '{"meta":"smoke-meta","contents":"smoke-contents","views":1}' "${api}/notes/" \
    | sed -nE 's/^\{"id":"([[:alnum:]]+)"\}$/\1/p')"
[ "$(curl -fsS "${api}/notes/${id}")" = '{"meta":"smoke-meta"}' ]
[ "$(curl -fsS -X DELETE "${api}/notes/${id}")" = '{"meta":"smoke-meta","contents":"smoke-contents"}' ]
[ "$(curl -sS -o /dev/null -w '%{http_code}' "${api}/notes/${id}")" = 404 ]
kill "${server}" "${valkey}"
wait "${server}" || [ "$?" -eq 143 ]
wait "${valkey}"
EORUN

FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

# Upstream image's paths, so its docs apply as is. The binary and the
# frontend: root's, not the build user's, so the server can't rewrite
# them. No CA bundle: no TLS client.
COPY --link --from=build --chown=0:0 /out/cryptgeon /app/cryptgeon
COPY --link --from=frontend-files /app/frontend/ /app/frontend/
COPY --link --from=source /LICENSE /usr/share/doc/cryptgeon/

# Numeric, so runAsNonRoot can check it. No privilege needed: the port is
# above 1024.
USER 65532:65532
# Upstream's: the server reads a .env from here (dotenv), if mounted.
WORKDIR /app
# Absolute, unlike upstream's ./frontend: it holds whatever the working
# directory. REDIS: upstream image's default, its compose service.
ENV FRONTEND_PATH=/app/frontend \
    REDIS=redis://redis/

EXPOSE 8000/tcp
# The server has no SIGTERM handler, and the kernel drops a signal PID 1
# doesn't handle: SIGTERM would only wait out the stop timeout (Docker's
# 10 s, Kubernetes' grace period, 30 s) before the SIGKILL. Nothing to
# drain: no graceful shutdown. Docker and containerd's CRI (Kubernetes)
# send the image's STOPSIGNAL.
STOPSIGNAL SIGKILL

# No arguments: settings are environment variables.
ENTRYPOINT ["/app/cryptgeon"]
