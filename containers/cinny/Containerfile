# syntax=docker.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#
# Cinny (https://github.com/cinnyapp/cinny), a Matrix web client: its
# static web app, built as upstream's Dockerfile builds it, served by
# static-web-server (https://static-web-server.net), one static musl
# binary, on scratch. Upstream serves it with nginx, as root, on port 80;
# here: not root, port 8080, and no shell.
#
# Runtime contract: UID/GID 65532 (no passwd entry). Stateless, no
# volume. HTTP on 8080/tcp (SERVER_PORT); the app is in /app, upstream's
# path. Its settings (homeservers, featured rooms, hash router) are
# /app/config.json, which the browser fetches: mount your own over it
# (Kubernetes: a ConfigMap with subPath). Probe: GET /health. Unknown
# paths answer index.html with status 200 (the app's router), missing
# files under /assets and /public included. Other settings are
# static-web-server's SERVER_* environment variables. TLS, CORS and
# security headers are off: terminate TLS in a proxy, and keep the
# security headers off, X-Frame-Options included: the app frames Element
# Call from its own origin. Runs with a read-only root filesystem, no
# capability and no-new-privileges: it writes nothing.
# https://static-web-server.net/configuration/environment-variables/

# Versions come from containers/cinny/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md).

# --checksum: the tag must resolve to this commit, tags can be moved. No
# .git: the app's version is hardcoded in its sources.
FROM scratch AS source
ARG BASE_VERSION
ARG BASE_CHECKSUM
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/cinnyapp/cinny.git#v${BASE_VERSION} /

# The server's source, pinned the same way.
FROM scratch AS sws-source
ARG SWS_VERSION
ARG SWS_CHECKSUM
ADD --link \
    --checksum=${SWS_CHECKSUM} \
    https://github.com/static-web-server/static-web-server.git#v${SWS_VERSION} /

# The web app: static files. Node: upstream's major (.node-version).
FROM docker.io/library/node:24.22-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 AS frontend

ARG BASE_VERSION
# HOME for the build user below (no passwd entry): npm keeps its cache in
# ~/.npm. Before SHELL: hadolint (2.15.1) checks the RUNs after an ENV or
# ARG as /bin/sh, whatever SHELL says.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# Built as the image's user, in its own copy: neither the packages nor
# the build get root.
USER 65532:65532
WORKDIR /build
COPY --link --from=source --chown=65532:65532 / /build/

# Upstream's release build (its Dockerfile, and the deploy workflow):
# npm ci, then npm run build, with the heap size it sets. ci installs
# package-lock.json's versions and integrity hashes; .npmrc's
# legacy-peer-deps is read from the source. --ignore-scripts: no install
# script runs. canvas' (an optional dependency of pdfjs-dist the browser
# bundle never loads) downloads an unverified prebuilt binary, or builds
# one; swc's and esbuild's only check binaries their platform packages
# ship; husky's (prepare) needs .git.
# The version check: the bundle holds the release it was built from.
# Then each text asset gets a .br and a .gz beside it, which the server
# sends as they are (SERVER_COMPRESSION_STATIC, off by default), where it
# would otherwise compress every response: Brotli at its best quality,
# gzip deterministic (Node writes no mtime). Not the sourcemaps (devtools only), and not the
# root config.json: the server prefers config.json.br to a mounted
# config.json. Kept only when smaller.
# The cache is one of its own, as the cargo caches below.
RUN --mount=type=cache,id=npm-cache-65532,uid=65532,gid=65532,target=/tmp/.npm <<EORUN
npm ci --ignore-scripts
NODE_OPTIONS=--max_old_space_size=4096 npm run build
grep -rqF "v${BASE_VERSION}" dist/assets
node --input-type=module <<'EOJS'
import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { extname, join } from 'node:path';
import { brotliCompressSync, constants, gzipSync } from 'node:zlib';

const text = new Set(['.css', '.html', '.js', '.json', '.mjs', '.svg', '.wasm']);
for (const entry of readdirSync('dist', { recursive: true, withFileTypes: true })) {
  const file = join(entry.parentPath, entry.name);
  if (!entry.isFile() || !text.has(extname(file)) || file === 'dist/config.json') continue;
  const data = readFileSync(file);
  const variants = [
    ['.br', brotliCompressSync(data, { params: { [constants.BROTLI_PARAM_QUALITY]: 11 } })],
    ['.gz', gzipSync(data, { level: 9 })],
  ];
  for (const [ext, packed] of variants) {
    if (packed.length < data.length) writeFileSync(file + ext, packed);
  }
}
EOJS
[ ! -e dist/config.json.br ]
[ ! -e dist/config.json.gz ]
EORUN

# What the image ships, and the packages npm installed, for the image's
# SBOM only: they are bundled into its JavaScript, where no scanner reads
# them. Every package, build tools included: the bundle holds some of
# them. A stage of its own: in the frontend stage, the SBOM would add
# node's image (its Debian packages, npm).
# The image copies the app from here: BuildKit scans only the stages the
# target depends on.
FROM scratch AS frontend-files
ARG BUILDKIT_SBOM_SCAN_STAGE=true
COPY --link --from=frontend /build/node_modules/ /node_modules/
COPY --link --from=frontend --chown=0:0 /build/dist/ /app/

# Debian trixie: its musl-tools build the C libraries.
FROM docker.io/library/rust:1.99-trixie@sha256:09027f873d45b8ecd1dc86f1fa13b7a62b875c961f017a0e331267b350430137 AS build

ARG SWS_VERSION
ARG DEBIAN_CODENAME
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NOWARNINGS="yes"
ARG DEBIAN_SNAPSHOT_VERSION
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# musl-tools: musl-gcc, for the C code of the crates (ring, zstd).
# cargo-auditable: embeds the dependency list in the binary, for the SBOM
# and the vulnerability scans. rustup's musl target is installed here too,
# while root.
# Not pinned (DL3008): versions follow the snapshot, which Renovate moves.
# Checks first: outside Bake, or on another Debian release than the build
# args name, the build fails here.
# Snapshot: see containers/AGENTS.md. No Valid-Until: snapshot Release
# files expire.
# hadolint ignore=DL3008
RUN <<EORUN
: "${SWS_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
sed -i -E "s#^URIs: http://deb\.debian\.org/(debian(-security)?)\$#URIs: http://snapshot.debian.org/archive/\1/${DEBIAN_SNAPSHOT_VERSION:?build with docker buildx bake, see containers/AGENTS.md}/#" /etc/apt/sources.list.d/debian.sources
echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
apt-get update
apt-get install -y --no-install-recommends cargo-auditable musl-tools
rm -rf /var/lib/apt/lists/*
rustup target add "$(uname -m)-unknown-linux-musl"
EORUN

# Built and tested as the image's user, in its own copy: neither the
# crates' build scripts nor the server get root. No passwd entry needed:
# CARGO_HOME and RUSTUP_HOME are set, /usr/local/cargo is writable by all.
# WORKDIR creates its folder owned by USER: /out takes the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /build
COPY --link --from=sws-source --chown=65532:65532 / /build/

# Upstream's release build (cargo build --release) with its default
# features, static: the rustup musl targets link statically by default.
# Its release workflow adds --features=all, the experimental tokio
# metrics: SERVER_METRICS stays off here. .cargo/config.toml, from the
# source, sets the --cfg tokio_unstable it needs. CC_<target>: cc-rs
# builds the C code with musl-gcc, not glibc's gcc. The version is
# Cargo.toml's.
# Caches: uid sets the owner of a new cache only, and one is shared by
# every build that uses its id (the target by default): ids of their own,
# as containers/garage does.
RUN --mount=type=cache,id=cargo-registry-65532,uid=65532,gid=65532,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sws-target-65532,uid=65532,gid=65532,target=/build/target \
    <<EORUN
target="$(uname -m)-unknown-linux-musl"
export "CC_${target//-/_}=musl-gcc"
cargo auditable build --locked --release --bin static-web-server --target "${target}"
cp "target/${target}/release/static-web-server" /out/
if readelf -dW /out/static-web-server | grep -qF NEEDED; then exit 1; fi
EORUN

# Server test, here because scratch has no shell to run it: the version,
# then the server with the app and the settings of the image's final
# stage (keep them equal), asked for what a browser asks for. /health
# answers 200; / and a deep link (/login) answer index.html; the app's
# own files are served as themselves: config.json, sw.js, a JavaScript
# bundle, its Brotli copy when the client accepts it, the crypto module
# as application/wasm; Element Call's page carries no X-Frame-Options; a
# missing file falls back to index.html, 200 (the Containerfile's header):
# files are checked by content or content type, not by what they lack.
# The log shows a request (not /health's: the server logs those at debug).
# SIGTERM stops it cleanly.
# kill (DL3001) stops the server this step started, not a container's.
# hadolint ignore=DL3001
RUN --mount=type=bind,from=frontend-files,source=/app,target=/app \
    <<EORUN
/out/static-web-server --version | grep -F "${SWS_VERSION}"
export SERVER_ROOT=/app SERVER_FALLBACK_PAGE=/app/index.html SERVER_HOST=127.0.0.1 SERVER_PORT=8080 \
    SERVER_HEALTH=true SERVER_CACHE_CONTROL_HEADERS=false SERVER_COMPRESSION_STATIC=true SERVER_LOG_LEVEL=info
/out/static-web-server > /tmp/server.log 2>&1 &
server=$!
url=http://127.0.0.1:8080
curl -fsS --retry 30 --retry-delay 1 --retry-connrefused "${url}/health"
curl -fsS "${url}/" | grep -F '<div id="root">'
curl -fsS "${url}/login" | grep -F '<div id="root">'
curl -fsS "${url}/config.json" | grep -F homeserverList
[ "$(curl -fsS -o /dev/null -w '%{content_type}' "${url}/sw.js")" = 'text/javascript' ]
bundle="$(sed -nE 's#.*src="(/assets/[^"]+\.js)".*#\1#p' /app/index.html)"
[ "$(curl -sS -o /dev/null -w '%{content_type}' "${url}${bundle}")" = 'text/javascript' ]
curl -fsS -D /tmp/headers -H 'Accept-Encoding: br' -o /tmp/bundle.br "${url}${bundle}"
grep -iF 'content-encoding: br' /tmp/headers
cmp /tmp/bundle.br "/app${bundle}.br"
wasm="$(find /app/assets -name '*.wasm' -print -quit)"
[ "$(curl -sS -o /dev/null -w '%{content_type}' "${url}${wasm#/app}")" = 'application/wasm' ]
curl -fsS -D /tmp/headers -o /dev/null "${url}/public/element-call/index.html"
if grep -iF x-frame-options /tmp/headers; then exit 1; fi
curl -fsS "${url}/assets/missing.js" | grep -F '<div id="root">'
grep -F 'incoming request: method=GET uri=/login' /tmp/server.log
kill "${server}"
wait "${server}"
rm /tmp/bundle.br /tmp/headers /tmp/server.log
EORUN

FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository. Licenses: the
# app's, and the server's (either of its two).
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="AGPL-3.0-only AND (MIT OR Apache-2.0)" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

# The server and the app: root's, not the build user's, so the server
# can't rewrite them. No CA bundle: no outbound TLS.
COPY --link --from=build --chown=0:0 /out/static-web-server /static-web-server
COPY --link --from=frontend-files /app/ /app/
COPY --link --from=source /LICENSE /usr/share/doc/cinny/
COPY --link --from=sws-source /LICENSE-MIT /LICENSE-APACHE /usr/share/doc/static-web-server/

# Numeric, so runAsNonRoot can check it. No privilege needed: the port is
# above 1024.
USER 65532:65532
# SERVER_FALLBACK_PAGE: the app's router, as upstream's nginx. No
# Cache-Control: unhashed files (sw.js) must not outlive a release, as
# nginx's. SERVER_COMPRESSION_STATIC: the .br and .gz files built above.
# SERVER_LOG_LEVEL: the server's default, error, logs nothing.
ENV SERVER_ROOT=/app \
    SERVER_FALLBACK_PAGE=/app/index.html \
    SERVER_PORT=8080 \
    SERVER_HEALTH=true \
    SERVER_CACHE_CONTROL_HEADERS=false \
    SERVER_COMPRESSION_STATIC=true \
    SERVER_LOG_LEVEL=info

EXPOSE 8080/tcp
# SIGTERM: the server stops gracefully on it.
ENTRYPOINT ["/static-web-server"]

RUN ["/static-web-server", "--version"]
