# syntax=docker.io/docker/dockerfile:1

# Garage, S3-compatible distributed object store
# (https://garagehq.deuxfleurs.fr), built from source as one static musl
# binary on scratch: close to upstream's dxflrs/garage, same paths and
# Cargo features, but not root and with an entrypoint.
#
# Runtime contract: UID/GID 65532 (no passwd entry); /var/lib/garage/meta
# and /var/lib/garage/data writable by it; a config at /etc/garage.toml
# (or GARAGE_CONFIG_FILE), none shipped; rpc_secret (and admin/metrics
# tokens) from GARAGE_RPC_SECRET_FILE or the like, a file not readable by
# others. Ports: those set in the config, upstream's 3900-3904 below.
# Host network for a multi-node cluster, as upstream's docs do.
# https://garagehq.deuxfleurs.fr/documentation/cookbook/real-world/

# Versions come from containers/garage/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md).
# Debian trixie: its musl-tools build the C libraries, its ca-certificates
# is the CA bundle copied below.
FROM docker.io/library/rust:1.99-trixie@sha256:81015672d6939b0265f09adf96d5de125482bb1330106076956b0518e74edc90 AS build

# BASE_VERSION: the upstream release; BASE_CHECKSUM: its tag's commit.
# DEBIAN_CODENAME: the release the tag names; DEBIAN_SNAPSHOT_VERSION:
# Debian's archive for the packages installed below.
ARG BASE_VERSION
ARG BASE_CHECKSUM
ARG DEBIAN_CODENAME
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
ARG DEBIAN_SNAPSHOT_VERSION
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]
WORKDIR /src

# musl-tools: musl-gcc, for the C code of the bundled libraries (libsodium,
# LMDB, SQLite, zstd, ring). protobuf-compiler: the OTLP exporter's
# prost-build. cargo-auditable: embeds the dependency list in the binary,
# for the SBOM and the vulnerability scans. ca-certificates: copied into
# the image below.
# Versions not pinned (DL3008): they follow the snapshot, which Renovate
# moves (containers/docker-bake.hcl). The musl target too, while root.
# The checks first: built alone (not with bake), or on another Debian
# release than the tag names, it fails here.
# The snapshot: apt-get's --snapshot is not in trixie's apt (3.0.3), so
# the sources point at snapshot.debian.org, as the base image's own
# comments say its build did. No Valid-Until: snapshot Release files
# expire.
# hadolint ignore=DL3008
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
sed -i -E "s#^URIs: http://deb\.debian\.org/(debian(-security)?)\$#URIs: http://snapshot.debian.org/archive/\1/${DEBIAN_SNAPSHOT_VERSION:?build with docker buildx bake, see containers/AGENTS.md}/#" /etc/apt/sources.list.d/debian.sources
echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
apt-get update
apt-get install -y --no-install-recommends ca-certificates cargo-auditable musl-tools protobuf-compiler
rm -rf /var/lib/apt/lists/*
rustup target add "$(uname -m)-unknown-linux-musl"
EORUN

# --checksum: the tag must resolve to this commit, tags can be moved.
# No .git: GIT_VERSION below sets the version.
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://git.deuxfleurs.fr/Deuxfleurs/garage.git#v${BASE_VERSION} /src

# Build and test as the image's user, not root: neither the crates' build
# scripts nor the server get root, and the source stays root's. No passwd
# entry needed: CARGO_HOME and RUSTUP_HOME are set, /usr/local/cargo is
# writable by all. WORKDIR creates its folder owned by USER: /out takes
# the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /src

# Static musl binary, as upstream's release builds (nix/compile.nix): the
# rustup musl targets link statically by default. CC_<target>: cc-rs builds
# the C libraries with musl-gcc, not glibc's gcc. Features: upstream's
# release set (nix/compile.nix, release = true), so the image does what
# dxflrs/garage does. GIT_VERSION: what `garage --version` prints, the tag,
# as upstream's CI sets it (.woodpecker/release.yaml).
# Caches: uid sets the owner of a new cache only, and one is shared by
# every build that uses its id (the target by default): ids of their own,
# as containers/minio does.
RUN --mount=type=cache,id=cargo-registry-65532,uid=65532,gid=65532,target=/usr/local/cargo/registry \
    --mount=type=cache,id=garage-target-65532,uid=65532,gid=65532,target=/src/target \
    <<EORUN
target="$(uname -m)-unknown-linux-musl"
export "CC_${target//-/_}=musl-gcc"
GIT_VERSION="v${BASE_VERSION}" PROTOC=/usr/bin/protoc cargo auditable build \
    --locked --release --target "${target}" --package garage \
    --features bundled-libs,lmdb,sqlite,fjall,k2v,consul-discovery,kubernetes-discovery,metrics,telemetry-otlp,syslog,journald
cp "target/${target}/release/garage" /out/
EORUN

# Server smoke test, here because scratch has no shell to run it: a
# single-node cluster (smoke-test.toml, next to this file) with a default
# key and bucket, then a 1 MiB object written and read back through the
# S3 API (large enough to go to the data directory, not inline in the
# metadata), then a graceful stop. Random throwaway secrets: none in the repository.
# kill (DL3001) stops the server this step started, not a container's.
# hadolint ignore=DL3001
RUN --mount=type=bind,source=smoke-test.toml,target=/etc/garage.toml \
    <<EORUN
/out/garage --version | grep -F "garage v${BASE_VERSION} ["
hex() { od -An -vtx1 -N32 /dev/urandom | tr -d ' \n'; }
GARAGE_RPC_SECRET="$(hex)"
GARAGE_DEFAULT_ACCESS_KEY="GK$(hex | cut -c1-24)"
GARAGE_DEFAULT_SECRET_KEY="$(hex)"
export GARAGE_RPC_SECRET GARAGE_DEFAULT_ACCESS_KEY GARAGE_DEFAULT_SECRET_KEY
export GARAGE_DEFAULT_BUCKET=smoke-test
/out/garage server --single-node --default-bucket &
server=$!
# 503 until the node has its layout: curl retries it.
curl -fsS --retry 30 --retry-delay 1 --retry-connrefused http://127.0.0.1:3903/health
/out/garage status
head -c 1M /dev/urandom > /tmp/object
s3=(curl -fsS --aws-sigv4 aws:amz:garage:s3 --user "${GARAGE_DEFAULT_ACCESS_KEY}:${GARAGE_DEFAULT_SECRET_KEY}")
"${s3[@]}" -T /tmp/object http://127.0.0.1:3900/smoke-test/object
"${s3[@]}" http://127.0.0.1:3900/smoke-test/object | cmp - /tmp/object
kill "${server}"
wait "${server}"
rm -r /tmp/garage /tmp/object
EORUN

# State directories, owned by the image's user (this stage's): a named
# volume mounted there starts with that owner, so it is writable without
# a chown.
RUN mkdir -p /out/var/lib/garage/meta /out/var/lib/garage/data

FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository, as the Dalec
# specs do.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="AGPL-3.0-only" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

# Upstream image's paths (/garage, /etc/garage.toml, /var/lib/garage/), so
# upstream's docs and Helm chart apply as is. CA bundle: TLS to Consul,
# Kubernetes or an OTLP collector with a public CA (rustls-native-certs
# reads this path); refreshed by the weekly rebuild.
# root's, not the build user's: the server can't replace its own binary.
COPY --link --from=build --chown=0:0 /out/garage /garage
COPY --link --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
# AGPL: the source is upstream's tag.
COPY --link --from=build /src/LICENSE /usr/share/doc/garage/
COPY --link --from=build --chown=65532:65532 /out/var/lib/garage/ /var/lib/garage/

# Numeric, so Kubernetes' runAsNonRoot can check it. Garage needs no
# privilege: every port is above 1024.
USER 65532:65532

# S3 API, RPC, S3 web, admin API (and metrics), K2V API: upstream's
# defaults, each enabled in garage.toml. Documentation only.
EXPOSE 3900/tcp 3901/tcp 3902/tcp 3903/tcp 3904/tcp
# Metadata (SSD) and data (HDD) apart, as upstream recommends.
VOLUME ["/var/lib/garage/meta", "/var/lib/garage/data"]

# Arguments are Garage's: `docker run <image> server --single-node`, or
# `--version`. Upstream's image has no entrypoint: drop the leading
# /garage of a command copied from its docs. Kubernetes' `command:` (as
# upstream's Helm chart sets it) replaces the entrypoint.
ENTRYPOINT ["/garage"]
CMD ["server"]

# Smoke test: the binary is static and runs on this platform (the build
# stage tested the server). Exec form: scratch has no shell.
RUN ["/garage", "--version"]
