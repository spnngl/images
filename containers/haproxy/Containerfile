# syntax=docker.io/docker/dockerfile:1

# HAProxy (https://www.haproxy.org) from source, on distroless/cc. One
# image per release line (docker-bake.hcl). The reason for each choice:
# containers/haproxy/REFERENCES.md.
#
# Runtime contract: UID/GID 99 (containers/haproxy/AGENTS.md).
# A config in /etc/haproxy (a volume, none shipped), the master process
# in the foreground (-db). Ports: 1936 stats, 8080 HTTP, 8443 HTTPS, 9101
# Prometheus, as the configs of the deployments use them (documentation
# only).

# The final image, named first so the build stage can read its passwd.
FROM gcr.io/distroless/cc-debian13@sha256:159783207c2cd44c2aa5715961d13c8612368ac9bd450f887e3f08fc8ea461e3 AS runtime

# Versions come from containers/haproxy/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md).
# Debian trixie, as the final image's: same glibc, same libraries.
FROM docker.io/library/debian:trixie@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5 AS build

ARG BASE_VERSION
ARG BASE_CHECKSUM
ARG DEBIAN_CODENAME
ARG DEBIAN_SNAPSHOT_VERSION
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NOWARNINGS="yes"
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# Checks first: outside Bake, or on another Debian release than the tag
# names, the build fails here.
# Snapshot: see containers/AGENTS.md. No Valid-Until: snapshot Release
# files expire.
# Not pinned (DL3008): versions follow the snapshot, which Renovate moves.
# /rootfs gets the runtime packages distroless/cc lacks, laid out as
# distroless lays out its own: the files, plus control fields and md5sums
# in /var/lib/dpkg/status.d, which the SBOM and the scanners read.
# /debs is _apt's: apt downloads as that user.
WORKDIR /debs
# hadolint ignore=DL3008
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
sed -i -E "s#^URIs: http://deb\.debian\.org/(debian(-security)?)\$#URIs: http://snapshot.debian.org/archive/\1/${DEBIAN_SNAPSHOT_VERSION:?build with docker buildx bake, see containers/AGENTS.md}/#" /etc/apt/sources.list.d/debian.sources
echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
apt-get update
apt-get install -y --no-install-recommends build-essential libssl-dev libpcre2-dev liblua5.4-dev libcrypt-dev lua-json
chown _apt /debs
apt-get download libpcre2-8-0 liblua5.4-0 libcrypt1 lua-json lua-lpeg
rm -rf /var/lib/apt/lists/*
install -d /rootfs/var/lib/dpkg/status.d
for deb in /debs/*.deb; do
    pkg="$(dpkg-deb --field "${deb}" Package)"
    dpkg-deb --extract "${deb}" /rootfs
    dpkg-deb --field "${deb}" > "/rootfs/var/lib/dpkg/status.d/${pkg}"
    dpkg-deb --ctrl-tarfile "${deb}" | tar -xO ./md5sums > "/rootfs/var/lib/dpkg/status.d/${pkg}.md5sums"
done
EORUN

# Each release line has its own repository: haproxy-<major>.<minor>.git.
# --checksum: the tag must resolve to this commit, tags can be moved.
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://git.haproxy.org/git/haproxy-${BASE_VERSION%.*}.git#v${BASE_VERSION} /build
WORKDIR /build

# The official image's options, QUIC on every line: 2.8 and 3.0 lack
# native QUIC on OpenSSL, so they get the compatibility layer (no
# 0-RTT). Upstream's defaults for the rest: libcrypt (encrypted userlist
# passwords), SLZ (compression), DEBUG (runtime checks).
# --strip-debug keeps the symbol table, for backtraces. -vv puts the
# build options in the build log.
# https://github.com/haproxy/haproxy/blob/master/INSTALL
RUN <<EORUN
opts=(TARGET=linux-glibc USE_GETADDRINFO=1 USE_LUA=1 LUA_INC=/usr/include/lua5.4
    USE_OPENSSL=1 USE_QUIC=1 USE_PCRE2=1 USE_PCRE2_JIT=1 USE_PROMEX=1
    USE_PTHREAD_EMULATION=1)
case "${BASE_VERSION}" in
    2.* | 3.0.*) opts+=(USE_QUIC_OPENSSL_COMPAT=1) ;;
esac
make -j"$(nproc)" "${opts[@]}"
./haproxy -vv
install -D -m 0755 haproxy /rootfs/usr/sbin/haproxy
strip --strip-debug /rootfs/usr/sbin/haproxy
EORUN

# The haproxy user and group appended to distroless' (root, nobody,
# nonroot). Its folders: distroless has no shell to make them.
COPY --from=runtime /etc/passwd /etc/group /rootfs/etc/
RUN <<EORUN
echo 'haproxy:x:99:99:haproxy:/var/lib/haproxy:/sbin/nologin' >> /rootfs/etc/passwd
echo 'haproxy:x:99:' >> /rootfs/etc/group
install -d -o 99 -g 99 /rootfs/etc/haproxy /rootfs/var/lib/haproxy /rootfs/var/run/haproxy
EORUN

FROM runtime
ARG BASE_VERSION

# source: links the ghcr.io package to this repository.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.title="HAProxy" \
    org.opencontainers.image.description="HAProxy on distroless" \
    org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="GPL-2.0-or-later" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

# COPY keeps the build stage's owners: root's files, haproxy's folders.
COPY --link --from=build /rootfs/ /

# Numeric, so runAsNonRoot can check it.
USER 99:99
WORKDIR /var/lib/haproxy
ENTRYPOINT ["/usr/sbin/haproxy"]
CMD ["-db", "-f", "/etc/haproxy"]
VOLUME ["/etc/haproxy"]

# Soft stop: listeners close, connections drain.
STOPSIGNAL SIGUSR1
EXPOSE 1936/tcp 8080/tcp 8443/tcp 9101/tcp

# Smoke test, as haproxy: the binary runs with the libraries of this
# image, and Lua loads lua-json (smoke-test.lua, next to this file).
RUN --mount=type=bind,source=smoke-test.cfg,target=/tmp/smoke-test.cfg \
    --mount=type=bind,source=smoke-test.lua,target=/tmp/smoke-test.lua \
    ["/usr/sbin/haproxy", "-c", "-f", "/tmp/smoke-test.cfg"]
