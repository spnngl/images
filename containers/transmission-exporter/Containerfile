# syntax=docker.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#
# Transmission exporter (Prometheus metrics of a Transmission daemon, Go)
# built from source as tagged, no patch, one static binary on scratch.
# Upstream (spnngl/transmission-exporter) publishes no image of its own:
# this is the one its README names.
#
# Runtime contract: UID/GID 65532 (no passwd entry); metrics on
# 19091/tcp at /metrics (WEB_ADDR, WEB_PATH); Transmission's RPC at
# TRANSMISSION_ADDR (http://localhost:9091 by default, https verified
# against the CA bundle), with TRANSMISSION_USERNAME and
# TRANSMISSION_PASSWORD when its RPC asks for them. No volume: it writes
# nothing. Runs with a read-only root filesystem, no capability and
# no-new-privileges.

# Versions come from containers/transmission-exporter/docker-bake.hcl:
# build with `docker buildx bake` (containers/AGENTS.md).
# Debian trixie: its transmission-daemon runs the server test, its
# ca-certificates is the CA bundle copied below.
FROM docker.io/library/golang:1.27-trixie@sha256:fbb7ae40b62ff8afe31662df570d39b4f5052ac32b90dae8e60d7657a20a74f4 AS build

ARG BASE_VERSION
ARG BASE_CHECKSUM
ARG DEBIAN_CODENAME
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NOWARNINGS="yes"
ARG DEBIAN_SNAPSHOT_VERSION
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
# HOME for the build user below (no passwd entry): go and
# transmission-daemon read theirs, and root's (/root) is closed to it.
# Before SHELL: hadolint (2.15.1) checks the RUNs after an ENV or ARG as
# /bin/sh, whatever SHELL says.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]
WORKDIR /src

# transmission-daemon: the Transmission the server test scrapes.
# ca-certificates: copied into the image below.
# Not pinned (DL3008): versions follow the snapshot, which Renovate moves.
# Checks first: outside Bake, or on another Debian release than the tag
# names, the build fails here.
# Snapshot: see containers/AGENTS.md. No Valid-Until: snapshot Release
# files expire.
# hadolint ignore=DL3008
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
sed -i -E "s#^URIs: http://deb\.debian\.org/(debian(-security)?)\$#URIs: http://snapshot.debian.org/archive/\1/${DEBIAN_SNAPSHOT_VERSION:?build with docker buildx bake, see containers/AGENTS.md}/#" /etc/apt/sources.list.d/debian.sources
echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
apt-get update
apt-get install -y --no-install-recommends ca-certificates transmission-daemon
rm -rf /var/lib/apt/lists/*
EORUN

# --checksum: the tag must resolve to this commit, tags can be moved.
# No .git: -X main.version below sets the version.
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/spnngl/transmission-exporter.git#v${BASE_VERSION} /src

# Build and test as the image's user, not root: neither the exporter nor
# Transmission get root, and the source stays root's. WORKDIR creates its
# folder owned by USER: /out takes the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /src

# Upstream's build (Makefile's build target: CGO_ENABLED=0), with the
# version its --version prints (cmd/transmission-exporter/main.go) and
# -trimpath, for a binary free of build paths.
# Caches: containers/minio's ids, the same user.
RUN --mount=type=cache,id=go-mod-65532,uid=65532,gid=65532,target=/go/pkg/mod \
    --mount=type=cache,id=go-build-65532,uid=65532,gid=65532,target=/tmp/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags "-X main.version=${BASE_VERSION}" \
    -o /out/transmission-exporter ./cmd/transmission-exporter

# Server smoke test, here because scratch has no shell to run it, and
# because exporter releases and golang bumps are automerged on it. A
# local Transmission with RPC authentication, one paused magnet added
# through its RPC (no DHT, LPD, port mapping or tracker: no peer), then a
# scrape through the exporter: /metrics answers 500 when an RPC call
# fails, and lists the session, in bytes per second for the speed limit
# (Transmission's default, 100 kB/s), and the torrent. Then a clean stop:
# SIGTERM exits 0. Random throwaway credentials.
# kill (DL3001) stops the servers this step started, not a container's.
# hadolint ignore=DL3001
RUN <<EORUN
/out/transmission-exporter --version | grep -Fx "transmission-exporter ${BASE_VERSION}"
hex() { od -An -vtx1 -N16 /dev/urandom | tr -d ' \n'; }
TRANSMISSION_USERNAME="$(hex)"
TRANSMISSION_PASSWORD="$(hex)"
export TRANSMISSION_USERNAME TRANSMISSION_PASSWORD
# The daemon doesn't always create its config folder before writing to it:
# on CI runners it saved nothing, and the final rm failed.
mkdir /tmp/transmission
transmission-daemon --foreground --config-dir /tmp/transmission \
    --download-dir /tmp/transmission/downloads \
    --bind-address-ipv4 127.0.0.1 --rpc-bind-address 127.0.0.1 --port 9091 \
    --auth --username "${TRANSMISSION_USERNAME}" --password "${TRANSMISSION_PASSWORD}" \
    --no-dht --no-lpd --no-portmap &
daemon=$!
# The first call answers 409 with the session id the next ones send.
rpc=(curl -sS --user "${TRANSMISSION_USERNAME}:${TRANSMISSION_PASSWORD}" http://127.0.0.1:9091/transmission/rpc/)
session="$("${rpc[@]}" --retry 30 --retry-delay 1 --retry-connrefused -o /dev/null -w '%header{x-transmission-session-id}')"
"${rpc[@]}" -f -H "X-Transmission-Session-Id: ${session}" \
    -d '{"method":"torrent-add","arguments":{"paused":true,"filename":"magnet:?xt=urn:btih:0123456789abcdef0123456789abcdef01234567&dn=smoke-test"}}' \
    | grep -F '"result":"success"'
TRANSMISSION_ADDR=http://127.0.0.1:9091 WEB_ADDR=127.0.0.1:19091 /out/transmission-exporter &
exporter=$!
curl -fsS --retry 30 --retry-delay 1 --retry-connrefused -o /tmp/metrics http://127.0.0.1:19091/metrics
grep -Fx 'transmission_session_stats_torrents_paused 1' /tmp/metrics
grep -Fx 'transmission_speed_limit_down_bytes{enabled="0"} 100000' /tmp/metrics
grep -Fx 'transmission_torrent_status{id="1",name="smoke-test",status="stopped"} 1' /tmp/metrics
kill "${exporter}"
wait "${exporter}"
kill "${daemon}"
wait "${daemon}"
rm -r /tmp/metrics /tmp/transmission
EORUN

# The exporter execs nothing and has no C library: the binary, the CA
# bundle for an https TRANSMISSION_ADDR, and the license (MIT: its
# notice ships with the binary).
FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

COPY --link --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --link --from=build /src/LICENSE /usr/share/doc/transmission-exporter/
# Owned by root, not by the build's user: the exporter can't rewrite its
# binary.
COPY --link --from=build --chown=0:0 /out/transmission-exporter /usr/bin/

# Numeric, so runAsNonRoot can check it. No privilege needed: the port is
# above 1024.
USER 65532:65532

EXPOSE 19091/tcp

# Settings are variables (upstream's Config): nothing in CMD to replace.
ENTRYPOINT ["/usr/bin/transmission-exporter"]

# Smoke test: the binary runs on this platform (the build stage tested the
# server).
RUN ["/usr/bin/transmission-exporter", "--version"]
