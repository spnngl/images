# syntax=docker.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#
# Sable (https://github.com/SableClient/sable-next), a Matrix web client:
# its static web app and its Rust core, compiled to WebAssembly, built
# from source as upstream's release workflow builds them, served by
# static-web-server (https://static-web-server.net), one static musl
# binary, on scratch. Upstream's image is Caddy serving an app built
# outside its Dockerfile; here: one build, and no shell.
#
# Runtime contract: UID/GID 65532 (no passwd entry). Stateless, no
# volume. HTTP on 8080/tcp (SERVER_PORT), as upstream's image; the app
# is in /app, upstream's path. Its settings (homeservers, push gateway,
# GIF providers) are /app/config.json, which the browser fetches: mount
# your own over it (Kubernetes: a ConfigMap with subPath). Probe: GET
# /health. A page is found without its .html (/login is login.html);
# other unknown paths answer index.html with status 200 (the app's
# router), missing files included. Response headers: upstream's
# _headers rules, in /sws.toml (SERVER_CONFIG_FILE); other settings are
# static-web-server's SERVER_* environment variables. Built without a
# Sentry DSN: no error reporting. TLS is off: terminate it in a proxy.
# Runs with a read-only root filesystem, no capability and
# no-new-privileges: it writes nothing.
# https://static-web-server.net/configuration/environment-variables/

# Versions come from containers/sable-next/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md).

# --checksum: the tag must resolve to this commit, tags can be moved. No
# .git: the build takes its version from VITE_APP_VERSION.
FROM scratch AS source
ARG BASE_VERSION
ARG BASE_CHECKSUM
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/SableClient/sable-next.git#v${BASE_VERSION} /

# The server's source, pinned the same way.
FROM scratch AS sws-source
ARG SWS_VERSION
ARG SWS_CHECKSUM
ADD --link \
    --checksum=${SWS_CHECKSUM} \
    https://github.com/static-web-server/static-web-server.git#v${SWS_VERSION} /

# Node: upstream's major (.mise/config.toml). Its binary also runs
# upstream's WebAssembly build script, in the wasm stage.
FROM docker.io/library/node:24.22-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS node

# Debian trixie: its musl-tools build the server's C libraries.
FROM docker.io/library/rust:1.99-trixie@sha256:931c2c0531a8b143e044f0f3914dfe802f15bb3d1955f0b657e9359327ac2ffc AS rust

# The Rust core: upstream's release build of it (pnpm wasm:build).
FROM rust AS wasm

# The image's own toolchain (RUST_VERSION is its environment): without
# it, rustup reads the source's rust-toolchain.toml and downloads
# upstream's pin with clippy and rustfmt.
ENV RUSTUP_TOOLCHAIN=${RUST_VERSION}
# No passwd entry for the build user below: HOME for the tools that
# still look. /tmp/bin: wasm-bindgen and wasm-opt, fetched below.
ENV HOME=/tmp
ENV PATH=/tmp/bin:${PATH}
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

RUN rustup target add wasm32-unknown-unknown
COPY --link --from=node /usr/local/bin/node /usr/local/bin/

# Built as the image's user, in its own copy: neither the crates' build
# scripts nor the tools get root.
USER 65532:65532
WORKDIR /build
COPY --link --from=source --chown=65532:65532 / /build/

# wasm-bindgen and binaryen's wasm-opt: the releases upstream's mise
# installs, as its .mise/mise.lock names them for this platform, with
# their sha256. No pin of ours: the tools move with the source.
# Upstream's build script checks wasm-bindgen against Cargo.lock.
RUN <<EORUN
case "$(uname -m)" in
    x86_64) platform=linux-x64 ;;
    aarch64) platform=linux-arm64 ;;
esac
# <key> = "<value>" of the table [tools."github:<tool>"."platforms.<platform>"].
locked() {
    awk -v table="[tools.\"github:$1\".\"platforms.${platform:?no tools for $(uname -m)}\"]" -v key="$2" \
        '$0 == table { inside = 1; next } /^$/ { inside = 0 } inside && $1 == key { gsub(/"/, "", $3); print $3 }' \
        .mise/mise.lock
}
mkdir /tmp/bin
fetch() {
    url="$(locked "$1" url)"
    checksum="$(locked "$1" checksum)"
    curl -fsSL -o /tmp/tool.tar.gz "${url:?$1 is not in .mise/mise.lock}"
    echo "${checksum#sha256:}  /tmp/tool.tar.gz" | sha256sum -c -
    tar -xzf /tmp/tool.tar.gz -C /tmp/bin --wildcards --strip-components="$2" "*/$3"
    rm /tmp/tool.tar.gz
}
fetch wasm-bindgen/wasm-bindgen 1 wasm-bindgen
fetch WebAssembly/binaryen 2 bin/wasm-opt
wasm-bindgen --version
wasm-opt --version
EORUN

# Upstream's build script: cargo build --locked of the two wasm crates,
# wasm-bindgen, wasm-opt, and its size budgets. Output:
# src/generated/wasm. The git cache: matrix-sdk is a git dependency.
# Caches: ids of their own, as containers/garage does.
RUN --mount=type=cache,id=cargo-registry-65532,uid=65532,gid=65532,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git-65532,uid=65532,gid=65532,target=/usr/local/cargo/git \
    --mount=type=cache,id=sable-next-target-65532,uid=65532,gid=65532,target=/build/target \
    node scripts/build/build-wasm.mjs --release

# The web app: static files.
FROM node AS frontend

ARG BASE_VERSION
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# HOME for the build user below (no passwd entry): corepack and pnpm keep
# their caches there. Before SHELL: hadolint (2.15.1) checks the RUNs
# after an ENV or ARG as /bin/sh, whatever SHELL says.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# pnpm: upstream's (package.json's packageManager), which corepack
# downloads and verifies. The shim goes in /usr/local/bin: root's.
RUN corepack enable pnpm

# Built as the image's user, in its own copy: neither the packages nor
# the build get root.
USER 65532:65532
WORKDIR /build
COPY --link --from=source --chown=65532:65532 / /build/
# --chown: a --link layer holds the parent folders too, root's otherwise.
COPY --link --from=wasm --chown=65532:65532 /build/src/generated/wasm/ /build/src/generated/wasm/

# Upstream's release build (.forgejo/actions/setup): pnpm install
# --frozen-lockfile, then vite build, with mise's NODE_OPTIONS and the
# release workflow's variables, its Sentry DSN left out (as its forks):
# Sentry stays off and its settings hidden. VITE_SENTRY_ENVIRONMENT:
# the stable release's, which makes the sourcemaps hidden (no
# sourceMappingURL in the bundle); they are then deleted: devtools only,
# 15% of the image. --frozen-lockfile:
# pnpm-lock.yaml's versions and integrity hashes. --ignore-scripts: no
# install script runs (REFERENCES.md); prepare (svelte-kit sync, git
# hooks) is vite build's own sync. The build downloads the DeepFilterNet
# assets and checks their sha256 (scripts/build/fetch-deepfilternet.mjs).
# The version check: the bundle holds the release VITE_APP_VERSION
# names ("v<version>", the About page's).
# The store is a cache of its own, as the cargo caches.
RUN --mount=type=cache,id=pnpm-store-65532,uid=65532,gid=65532,target=/tmp/pnpm-store <<EORUN
pnpm install --frozen-lockfile --ignore-scripts --store-dir /tmp/pnpm-store
VITE_APP_VERSION="${BASE_VERSION}" SABLE_BUILD_FLAVOR=stable VITE_SENTRY_ENVIRONMENT=production \
    NODE_OPTIONS=--max-old-space-size=4096 pnpm exec vite build
find dist -name '*.map' -delete
grep -rqF "v${BASE_VERSION}" dist/_app
EORUN

# What upstream's host does beside serving files. Its _headers rules
# become the server's: sws.toml, [[advanced.headers]] globs, where `*`
# matches across `/` as _headers' splat does. Only absolute paths with
# `*` and `Name: value` lines are read; anything else fails the build.
# Then each text asset gets a .br and a .gz beside it, which the server
# sends as they are (SERVER_COMPRESSION_STATIC, off by default), where it
# would otherwise compress every response: Brotli at its best quality,
# gzip deterministic (Node writes no mtime). Not the root config.json:
# the server prefers config.json.br to a mounted config.json. Kept only
# when smaller.
RUN <<EORUN
node --input-type=module <<'EOJS'
import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { extname, join } from 'node:path';
import { brotliCompressSync, constants, gzipSync } from 'node:zlib';

const rules = [];
for (const [index, line] of readFileSync('dist/_headers', 'utf8').split('\n').entries()) {
  const at = `dist/_headers:${index + 1}`;
  if (line.trim() === '' || line.trimStart().startsWith('#')) continue;
  if (!/^\s/.test(line)) {
    if (!/^\/[^\s:?[\]{}!\\]*$/.test(line)) throw new Error(`${at}: unsupported path ${line}`);
    rules.push({ source: line, headers: {} });
    continue;
  }
  const header = /^\s+([A-Za-z0-9-]+):\s*(\S.*)$/.exec(line);
  const rule = rules.at(-1);
  if (!header || !rule || header[1] in rule.headers) throw new Error(`${at}: unsupported line ${line}`);
  rule.headers[header[1]] = header[2];
}
const toml = rules.map(({ source, headers }) => {
  const pairs = Object.entries(headers).map(([name, value]) => `${JSON.stringify(name)} = ${JSON.stringify(value)}`);
  return `[[advanced.headers]]\nsource = ${JSON.stringify(source)}\nheaders = { ${pairs.join(', ')} }\n`;
});
writeFileSync('sws.toml', ['[advanced]\n', ...toml].join('\n'));

const text = new Set(['.css', '.html', '.js', '.json', '.mjs', '.svg', '.wasm', '.webmanifest']);
for (const entry of readdirSync('dist', { recursive: true, withFileTypes: true })) {
  const file = join(entry.parentPath, entry.name);
  if (!entry.isFile() || !text.has(extname(file)) || file === 'dist/config.json') continue;
  const data = readFileSync(file);
  const variants = [
    ['.br', brotliCompressSync(data, { params: { [constants.BROTLI_PARAM_QUALITY]: 11 } })],
    ['.gz', gzipSync(data, { level: 9 })],
  ];
  for (const [ext, packed] of variants) {
    if (packed.length < data.length) writeFileSync(file + ext, packed);
  }
}
EOJS
cat sws.toml
[ ! -e dist/config.json.br ]
[ ! -e dist/config.json.gz ]
EORUN

# What the image ships, and the packages pnpm installed, for the image's
# SBOM only: they are bundled into its JavaScript, where no scanner reads
# them. Every package, build tools included: the bundle holds some of
# them. A stage of its own: in the frontend stage, the SBOM would add
# node's image (its Debian packages, npm).
# The image copies the app from here: BuildKit scans only the stages the
# target depends on.
FROM scratch AS frontend-files
ARG BUILDKIT_SBOM_SCAN_STAGE=true
COPY --link --from=frontend /build/node_modules/.pnpm/ /node_modules/.pnpm/
COPY --link --from=frontend --chown=0:0 /build/dist/ /app/
COPY --link --from=frontend --chown=0:0 /build/sws.toml /sws.toml

FROM rust AS build

ARG SWS_VERSION
ARG DEBIAN_CODENAME
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NOWARNINGS="yes"
ARG DEBIAN_SNAPSHOT_VERSION
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# musl-tools: musl-gcc, for the C code of the crates (ring, zstd).
# cargo-auditable: embeds the dependency list in the binary, for the SBOM
# and the vulnerability scans. rustup's musl target is installed here too,
# while root.
# Not pinned (DL3008): versions follow the snapshot, which Renovate moves.
# Checks first: outside Bake, or on another Debian release than the build
# args name, the build fails here.
# Snapshot: see containers/AGENTS.md. No Valid-Until: snapshot Release
# files expire.
# hadolint ignore=DL3008
RUN <<EORUN
: "${SWS_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
sed -i -E "s#^URIs: http://deb\.debian\.org/(debian(-security)?)\$#URIs: http://snapshot.debian.org/archive/\1/${DEBIAN_SNAPSHOT_VERSION:?build with docker buildx bake, see containers/AGENTS.md}/#" /etc/apt/sources.list.d/debian.sources
echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
apt-get update
apt-get install -y --no-install-recommends cargo-auditable musl-tools
rm -rf /var/lib/apt/lists/*
rustup target add "$(uname -m)-unknown-linux-musl"
EORUN

# Built and tested as the image's user, in its own copy: neither the
# crates' build scripts nor the server get root. No passwd entry needed:
# CARGO_HOME and RUSTUP_HOME are set, /usr/local/cargo is writable by all.
# WORKDIR creates its folder owned by USER: /out takes the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /build
COPY --link --from=sws-source --chown=65532:65532 / /build/

# The server as containers/cinny builds it (its REFERENCES.md): cargo
# build --release, default features, static. CC_<target>: cc-rs builds
# the C code with musl-gcc, not glibc's gcc. The target cache is
# cinny's: the same source.
RUN --mount=type=cache,id=cargo-registry-65532,uid=65532,gid=65532,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sws-target-65532,uid=65532,gid=65532,target=/build/target \
    <<EORUN
target="$(uname -m)-unknown-linux-musl"
export "CC_${target//-/_}=musl-gcc"
cargo auditable build --locked --release --bin static-web-server --target "${target}"
cp "target/${target}/release/static-web-server" /out/
if readelf -dW /out/static-web-server | grep -qF NEEDED; then exit 1; fi
EORUN

# Server test, here because scratch has no shell to run it: the version,
# then the server with the app and the settings of the image's final
# stage (keep them equal), asked for what a browser asks for. /health
# answers 200; / and a deep link answer the app; a page without its
# .html answers the page; the app's own files are served as themselves:
# config.json (no-cache, from _headers), the service worker, a bundle
# (immutable, from _headers), its Brotli copy when the client accepts
# it, the core as application/wasm, the manifest; a missing file falls
# back to index.html, 200 (the Containerfile's header). The log shows a
# request (not /health's: the server logs those at debug). SIGTERM stops
# it cleanly.
# kill (DL3001) stops the server this step started, not a container's.
# hadolint ignore=DL3001
RUN --mount=type=bind,from=frontend-files,source=/app,target=/app \
    --mount=type=bind,from=frontend-files,source=/sws.toml,target=/sws.toml \
    <<EORUN
/out/static-web-server --version | grep -F "${SWS_VERSION}"
export SERVER_ROOT=/app SERVER_FALLBACK_PAGE=/app/index.html SERVER_HOST=127.0.0.1 SERVER_PORT=8080 \
    SERVER_HEALTH=true SERVER_CACHE_CONTROL_HEADERS=false SERVER_COMPRESSION_STATIC=true SERVER_LOG_LEVEL=info \
    SERVER_CONFIG_FILE=/sws.toml
/out/static-web-server > /tmp/server.log 2>&1 &
server=$!
url=http://127.0.0.1:8080
app='__sveltekit_'
curl -fsS --retry 30 --retry-delay 1 --retry-connrefused "${url}/health"
curl -fsS "${url}/" | grep -F "${app}"
curl -fsS "${url}/home/!room:example.org" | grep -F "${app}"
curl -fsS "${url}/login" | cmp - /app/login.html
curl -fsS -D /tmp/headers "${url}/config.json" | grep -F homeserverList
grep -iF 'cache-control: no-cache' /tmp/headers
curl -fsS "${url}/service-worker.js" | grep -vF "${app}"
bundle="$(grep -oE '/_app/immutable/entry/start\.[^"]+\.js' /app/index.html | head -n 1)"
curl -fsS -D /tmp/headers -o /dev/null "${url}${bundle}"
grep -iF 'content-type: text/javascript' /tmp/headers
grep -iF 'cache-control: public, max-age=31536000, immutable' /tmp/headers
curl -fsS -D /tmp/headers -H 'Accept-Encoding: br' -o /tmp/bundle.br "${url}${bundle}"
grep -iF 'content-encoding: br' /tmp/headers
cmp /tmp/bundle.br "/app${bundle}.br"
wasm="$(find /app/_app -name 'sable_wasm_bg*.wasm' -print -quit)"
[ "$(curl -sS -o /dev/null -w '%{content_type}' "${url}${wasm#/app}")" = 'application/wasm' ]
[ "$(curl -sS -o /dev/null -w '%{content_type}' "${url}/manifest.webmanifest")" = 'application/manifest+json' ]
curl -fsS "${url}/_app/missing.js" | grep -F "${app}"
grep -F 'incoming request: method=GET uri=/login' /tmp/server.log
kill "${server}"
wait "${server}"
rm /tmp/bundle.br /tmp/headers /tmp/server.log
EORUN

FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository. Licenses: the
# app's, and the server's (either of its two).
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="AGPL-3.0-or-later AND (MIT OR Apache-2.0)" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

# The server, its headers and the app: root's, not the build user's, so
# the server can't rewrite them. No CA bundle: no outbound TLS.
COPY --link --from=build --chown=0:0 /out/static-web-server /static-web-server
COPY --link --from=frontend-files /sws.toml /sws.toml
COPY --link --from=frontend-files /app/ /app/
COPY --link --from=source /LICENSE /usr/share/doc/sable-next/
COPY --link --from=sws-source /LICENSE-MIT /LICENSE-APACHE /usr/share/doc/static-web-server/

# Numeric, so runAsNonRoot can check it. No privilege needed: the port is
# above 1024.
USER 65532:65532
# SERVER_FALLBACK_PAGE: the app's router, as upstream's Caddyfile. No
# default Cache-Control: unhashed files (the service worker) must not
# outlive a release; _headers' rules set theirs. SERVER_CONFIG_FILE: an
# absolute path, the default is relative. SERVER_COMPRESSION_STATIC: the
# .br and .gz files built above. SERVER_LOG_LEVEL: the server's default,
# error, logs nothing.
ENV SERVER_ROOT=/app \
    SERVER_FALLBACK_PAGE=/app/index.html \
    SERVER_PORT=8080 \
    SERVER_HEALTH=true \
    SERVER_CACHE_CONTROL_HEADERS=false \
    SERVER_COMPRESSION_STATIC=true \
    SERVER_LOG_LEVEL=info \
    SERVER_CONFIG_FILE=/sws.toml

EXPOSE 8080/tcp
# SIGTERM: the server stops gracefully on it.
ENTRYPOINT ["/static-web-server"]

RUN ["/static-web-server", "--version"]
