# syntax=docker.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#
# Mailpit (https://mailpit.axllent.org), an SMTP server that catches mail
# for testing, with a web UI and an API, built from source as one static
# binary on scratch. Differs from upstream's axllent/mailpit (Alpine, root):
# not root, messages kept in /data instead of a temporary file, no
# sendmail links.
#
# Runtime contract: UID/GID 65532 (no passwd entry); /data writable by it
# (the SQLite database, MP_DATABASE); SMTP on 1025/tcp, web UI and API on
# 8025/tcp, POP3 on 1110/tcp once MP_POP3_AUTH is set. No credential by
# default: set MP_UI_AUTH, MP_SMTP_AUTH (or their *_FILE flags) when the
# ports are reachable by others. TZ names the local time zone. Runs with a
# read-only root filesystem, no capability and no-new-privileges: Mailpit
# only writes to /data.
# https://mailpit.axllent.org/docs/install/docker/

# Versions come from containers/mailpit/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md).
# The web UI (JavaScript and CSS, embedded in the binary): upstream's
# release builds it with Node 22 (.github/workflows/build-release.yml).
# On the build platform: the output is the same for every platform, and a
# cross build runs no emulated Node.
FROM --platform=${BUILDPLATFORM} docker.io/library/node:24-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 AS ui

ARG BASE_VERSION
ARG BASE_CHECKSUM
ARG DEBIAN_CODENAME
# HOME for the build user below (no passwd entry): npm keeps its cache
# there. Before SHELL: hadolint (2.15.1) checks the RUNs after an ENV or
# ARG as /bin/sh, whatever SHELL says.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# Checks first: outside Bake, or on another Debian release than the tag
# names, the build fails here.
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
EORUN

# --checksum: the tag must resolve to this commit, tags can be moved.
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/axllent/mailpit.git#v${BASE_VERSION} /src

# npm and esbuild run as the image's user, not root: the source stays
# root's, and only the folders npm writes are the user's.
RUN install -d -o 65532 -g 65532 /src/node_modules /src/server/ui/dist
USER 65532:65532
WORKDIR /src

# Upstream's release build of the UI (package.json's package script),
# from package-lock.json. --ignore-scripts: the packages' install scripts
# (telemetry, native fallbacks) change nothing in the output.
# Cache id of its own, as the Go ones below.
RUN --mount=type=cache,id=npm-65532,uid=65532,gid=65532,target=/tmp/.npm \
    <<EORUN
npm ci --ignore-scripts
npm run package
EORUN

# Debian trixie: its ca-certificates and tzdata are copied below.
FROM docker.io/library/golang:1.27-trixie@sha256:c65ecfe613b539ac74c62a4c3b2c27e8f8a6076384c8f27e8a3c0f3be17cc385 AS build

ARG BASE_VERSION
ARG BASE_CHECKSUM
ARG DEBIAN_CODENAME
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
# HOME for the build user below, as in the ui stage: go reads it.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
EORUN

# No .git: the ldflags below set the version.
ADD --link \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/axllent/mailpit.git#v${BASE_VERSION} /src
# Where go:embed reads the UI (server/embed.go).
COPY --link --from=ui /src/server/ui/dist /src/server/ui/dist

# Build and test as the image's user, not root, as containers/minio does:
# the server runs as in the image, and the source stays root's. WORKDIR
# creates its folder owned by USER: /out takes the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /src

# Upstream's release build (.github/workflows/build-release.yml): no cgo
# (SQLite is modernc.org/sqlite, pure Go), the version as the tag. No
# go-licenses run: the binary's third-party license page says "not
# available", as in a source build.
# Caches: ids of their own, shared with containers/minio (its comment).
RUN --mount=type=cache,id=go-mod-65532,uid=65532,gid=65532,target=/go/pkg/mod \
    --mount=type=cache,id=go-build-65532,uid=65532,gid=65532,target=/tmp/.cache/go-build \
    <<EORUN
CGO_ENABLED=0 go build \
    -ldflags "-w -X github.com/axllent/mailpit/config.Version=v${BASE_VERSION}" \
    -o /out/mailpit
mkdir /out/data
EORUN

# Server smoke test, here because scratch has no shell to run it, and
# because golang bumps are automerged on it (REFERENCES.md). The image's
# health check (readyz) until ready, the embedded UI served, a message
# sent over SMTP and read back through the API, behind random throwaway
# UI credentials, then a graceful stop.
# kill (DL3001) stops the server this step started, not a container's.
# hadolint ignore=DL3001
RUN <<EORUN
/out/mailpit version --no-release-check | grep -F "/out/mailpit v${BASE_VERSION} compiled with "
hex() { od -An -vtx1 -N16 /dev/urandom | tr -d ' \n'; }
user="$(hex)"
password="$(hex)"
subject="$(hex)"
mkdir /tmp/data
MP_UI_AUTH="${user}:${password}" /out/mailpit --disable-version-check \
    --database /tmp/data/mailpit.db --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025 &
server=$!
/out/mailpit readyz --wait --listen 127.0.0.1:8025
[ "$(curl -sS -o /dev/null -w '%{http_code}' http://127.0.0.1:8025/api/v1/messages)" = 401 ]
api=(curl -fsS --user "${user}:${password}")
"${api[@]}" -o /dev/null http://127.0.0.1:8025/dist/app.js
printf 'From: a@example.com\r\nTo: b@example.com\r\nSubject: %s\r\n\r\nsmoke test\r\n' "${subject}" > /tmp/message
curl -fsS --mail-from a@example.com --mail-rcpt b@example.com -T /tmp/message smtp://127.0.0.1:1025
"${api[@]}" http://127.0.0.1:8025/api/v1/message/latest | grep -F "\"Subject\":\"${subject}\""
kill "${server}"
wait "${server}"
rm -r /tmp/data /tmp/message
EORUN

# Mailpit execs nothing and has no C library: the binary, the CA bundle
# for its outbound TLS (SMTP relay and forward, webhooks, link checker,
# screenshots), Debian's time zones and the license (MIT).
FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

COPY --link --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
# Go's time package reads them: TZ and the search's time zone
# (internal/storage/search.go).
COPY --link --from=build /usr/share/zoneinfo /usr/share/zoneinfo
COPY --link --from=build /src/LICENSE /usr/share/doc/mailpit/
# Owned by root, not by the build's user: Mailpit can't rewrite its binary.
COPY --link --from=build --chown=0:0 /out/mailpit /usr/bin/
# Owned by the user: a new Docker volume on /data takes this ownership.
COPY --link --from=build --chown=65532:65532 /out/data /data

# Numeric, so runAsNonRoot can check it. No privilege needed: every port
# is above 1024.
USER 65532:65532
# Variables, not flags, so that they stay when CMD is replaced.
# MP_DATABASE: upstream's default is a temporary file in /tmp, read-only
# here. MP_DISABLE_VERSION_CHECK: no release check against GitHub, the
# image is the update.
ENV MP_DATABASE=/data/mailpit.db \
    MP_DISABLE_VERSION_CHECK=true

EXPOSE 1025/tcp 1110/tcp 8025/tcp
VOLUME ["/data"]

# Upstream's: the binary queries its own /readyz, at MP_UI_BIND_ADDR and
# MP_WEBROOT (cmd/readyz.go).
HEALTHCHECK --interval=15s --start-period=10s --start-interval=1s \
    CMD ["/usr/bin/mailpit", "readyz"]

# Arguments are Mailpit's: `docker run <image> --max 1000`.
ENTRYPOINT ["/usr/bin/mailpit"]

# Smoke test: the binary runs on this platform (the build stage tested the
# server). No release check: the build has no business calling GitHub.
RUN ["/usr/bin/mailpit", "version", "--no-release-check"]
