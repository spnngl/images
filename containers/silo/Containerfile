# syntax=docker.io/docker/dockerfile:1
#
# Silo server (S3-compatible object storage) built from source, on scratch.
# Silo is the maintained, community fork of the MinIO server (Pigsty,
# AGPL), compatible with its data, variables and API: upstream MinIO is
# archived, with known vulnerabilities it will never fix. Upstream's
# release as tagged, with no patch. See containers/silo/REFERENCES.md.
#
# Runtime contract: UID/GID 65532 (no passwd entry); /data writable by it;
# S3 API on 9000/tcp, console on 9001/tcp; MINIO_ROOT_USER and
# MINIO_ROOT_PASSWORD (or their *_FILE variants) set, or Silo uses the
# well-known minioadmin:minioadmin. TLS: public.crt and private.key, and
# CAs/ for the private CAs Silo must trust, mounted in /certs. A non-default
# S3 address goes in MINIO_ADDRESS, not --address: the HEALTHCHECK reads
# it. Runs with a read-only root filesystem, no capability and
# no-new-privileges: Silo only writes to /data.
# https://silo.pgsty.com

# Versions come from containers/silo/docker-bake.hcl: build with
# `docker buildx bake` (containers/AGENTS.md).
# Debian trixie: its ca-certificates is the CA bundle copied below.
FROM docker.io/library/golang:1.27-trixie@sha256:2f84bc93ecfb2689f782b153fdcd368b5a7ab96c1386c65cdaccf35e726d6a44 AS build

ARG BASE_VERSION
ARG BASE_CHECKSUM
ARG DEBIAN_CODENAME
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
# HOME for the build user below (no passwd entry): git and go read theirs,
# and root's (/root) is closed to it. Before SHELL: hadolint (2.15.1)
# checks the RUNs after an ENV or ARG as /bin/sh, whatever SHELL says.
ENV HOME=/tmp
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]
WORKDIR /src

# Checks first: outside Bake, or on another Debian release than the tag
# names, the build fails here.
RUN <<EORUN
: "${BASE_VERSION:?build with docker buildx bake, see containers/AGENTS.md}"
[ "$(. /etc/os-release; echo "${VERSION_CODENAME}")" = "${DEBIAN_CODENAME:?build with docker buildx bake, see containers/AGENTS.md}" ]
EORUN

# --checksum: the tag must resolve to this commit.
# --keep-git-dir: gen-ldflags.go reads the commit ID with git.
ADD --link \
    --keep-git-dir=true \
    --checksum=${BASE_CHECKSUM} \
    https://github.com/pgsty/silo.git#${BASE_VERSION} /src

# git refuses a repository another user owns: trust this one, while root.
RUN git config --system --add safe.directory /src

# Build and test as the image's user, not root, as containers/minio does.
# WORKDIR creates its folder owned by USER: /out takes the build output.
USER 65532:65532
WORKDIR /out
WORKDIR /src

# Upstream's release build (.github/workflows/release.yml and
# .github/goreleaser.yml), version included: gen-ldflags.go takes the tag's
# time in RFC 3339 (<date>T<hh:mm:ss>Z for RELEASE.<date>T<hh-mm-ss>Z) and
# MINIO_RELEASE as the tag's prefix. Without them, the binary is a
# DEVELOPMENT.GOGET build. Caches: containers/minio's ids, the same user.
# DL3062: `go run` of a file in the checkout, not of a remote module.
# hadolint ignore=DL3062
RUN --mount=type=cache,id=go-mod-65532,uid=65532,gid=65532,target=/go/pkg/mod \
    --mount=type=cache,id=go-build-65532,uid=65532,gid=65532,target=/tmp/.cache/go-build \
    <<EORUN
version="${BASE_VERSION#RELEASE.}"
clock="${version#*T}"
version="${version%%T*}T${clock//-/:}"
CGO_ENABLED=0 go build -tags kqueue -trimpath \
    -ldflags "$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go "${version}")" \
    -o /out/silo
mkdir /out/data
EORUN

# Server smoke test, here because scratch has no shell to run it, and
# because Silo releases and golang bumps are automerged on it. A
# single-drive server, the HEALTHCHECK's command, a bucket, a 1 MiB object
# written and read back through the S3 API, then a graceful stop. Random
# throwaway credentials.
# kill (DL3001) stops the server this step started, not a container's.
# hadolint ignore=DL3001
RUN <<EORUN
/out/silo --version | grep -F "silo version ${BASE_VERSION} (commit-id="
hex() { od -An -vtx1 -N16 /dev/urandom | tr -d ' \n'; }
MINIO_ROOT_USER="$(hex)"
MINIO_ROOT_PASSWORD="$(hex)"
export MINIO_ROOT_USER MINIO_ROOT_PASSWORD MINIO_ADDRESS=127.0.0.1:9000
/out/silo --certs-dir /tmp/certs server --console-address 127.0.0.1:9001 /tmp/data &
server=$!
# 503 until the drive is formatted: curl retries it.
curl -fsS --retry 30 --retry-delay 1 --retry-connrefused http://127.0.0.1:9000/minio/health/ready
/out/silo --certs-dir /tmp/certs healthcheck ready
head -c 1M /dev/urandom > /tmp/object
s3=(curl -fsS --aws-sigv4 aws:amz:us-east-1:s3 --user "${MINIO_ROOT_USER}:${MINIO_ROOT_PASSWORD}")
"${s3[@]}" -X PUT http://127.0.0.1:9000/smoke-test
"${s3[@]}" -T /tmp/object http://127.0.0.1:9000/smoke-test/object
"${s3[@]}" http://127.0.0.1:9000/smoke-test/object | cmp - /tmp/object
kill "${server}"
wait "${server}"
rm -r /tmp/certs /tmp/data /tmp/object
EORUN

# Silo only execs itself (restart) and has no C library: the binary, the CA
# bundle for its outbound TLS (OpenID, LDAP, KMS, replication, notification
# targets), and the licenses (AGPL: the source is upstream's tag).
FROM scratch
ARG BASE_VERSION

# source: links the ghcr.io package to this repository.
# hadolint ignore=DL3050
LABEL org.opencontainers.image.version="${BASE_VERSION}" \
    org.opencontainers.image.licenses="AGPL-3.0-or-later" \
    org.opencontainers.image.source="https://github.com/spnngl/images"

COPY --link --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --link --from=build /src/LICENSE /src/NOTICE /src/CREDITS /usr/share/doc/silo/
# Owned by root, not by the build's user: Silo can't rewrite its binary.
COPY --link --from=build --chown=0:0 /out/silo /usr/bin/
# Owned by the user: a new Docker volume on /data takes this ownership.
COPY --link --from=build --chown=65532:65532 /out/data /data

# Numeric, so runAsNonRoot can check it.
USER 65532:65532
# A variable, not a flag, so that it stays when CMD is replaced (several
# drives, distributed setup); a random port without it. No MINIO_UPDATE:
# Silo removed in-place updates and warns when it is set.
ENV MINIO_CONSOLE_ADDRESS=:9001

EXPOSE 9000/tcp 9001/tcp
VOLUME ["/data"]

# Upstream's (Dockerfile.distroless): the binary probes
# /minio/health/ready, on MINIO_ADDRESS (:9000 by default), over HTTPS when
# /certs holds a key pair. --certs-dir: a HEALTHCHECK doesn't go through
# the entrypoint. Kubernetes ignores it: probe /minio/health/ready there.
HEALTHCHECK --interval=30s --timeout=10s --start-period=2m --start-interval=2s --retries=3 \
    CMD ["/usr/bin/silo", "--certs-dir", "/certs", "healthcheck", "ready"]

# --certs-dir in the entrypoint, so that it stays when CMD is replaced.
# The default, ~/.silo/certs, depends on HOME: / without a passwd entry.
# A global flag, before the command.
ENTRYPOINT ["/usr/bin/silo", "--certs-dir", "/certs"]
CMD ["server", "/data"]

# Smoke test: the binary runs on this platform (the build stage tested the
# server).
RUN ["/usr/bin/silo", "--version"]
